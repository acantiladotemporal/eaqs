---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/ui/Button.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import {
  COURSE_MODULES,
  COURSE_SEAT_LIMIT,
  COURSE_TIMELINE,
  COURSE_LAUNCH_PRICE_EUR,
  COURSE_STANDARD_PRICE_EUR,
  INTEGRATION_WEEKEND,
} from '../lib/course-data';

const moduleRows = COURSE_MODULES.map((module) => ({
  id: module.numero,
  title: module.title,
  description: module.description,
}));

const formationFeatures = [
  '10 modulos con recursos y prueba por cada bloque',
  'Acceso permanente a clases y materiales',
  'Certificacion oficial de la Escuela',
  'Comunidad docente internacional',
  'Mentoria en directo con Azahara',
  'Apertura por calendario de cohorte + progreso por quiz',
];

const faqs = [
  {
    question: 'Necesito ser docente de musica para aprovechar el curso?',
    answer: 'No. Esta formacion esta pensada para docentes y profesionales que trabajan con infancia de 0 a 9 anos.',
  },
  {
    question: 'Cuanto tiempo necesito cada semana?',
    answer: 'Entre 2 y 4 horas semanales entre clase, observacion y aplicacion en aula.',
  },
  {
    question: 'Como se desbloquean los modulos?',
    answer:
      'La apertura es por calendario de edicion. Cada modulo incluye quiz y recursos propios para consolidar el aprendizaje.',
  },
  {
    question: 'Es teorico o practico?',
    answer: 'Es practico: cada modulo termina con propuestas listas para implementar.',
  },
  {
    question: 'Y si aun no quiero inscribirme?',
    answer: 'Puedes entrar gratis en la newsletter semanal y avanzar a tu ritmo.',
  },
];
---

<Layout
  title="Curso de Neuroeducación Musical | El Árbol Que Suena"
  description="Escuela Internacional de Neuroeducación Musical. Primera edición para docentes de 0 a 9 años con foco en primera infancia."
>
  <Header />

  <main class="rhythm-layer sales-home overflow-hidden">
    <section class="section-shell pt-44 md:pt-56">
      <div class="content-shell max-w-5xl text-center">
        <p class="editorial-kicker mb-8" data-reveal>Escuela Internacional de Neuroeducación Musical</p>
        <h1 class="headline-luxe headline-rhythm hero-title sales-hero-title mb-7" data-reveal style="--reveal-delay:90ms">
        Donde vuelves a ser el maestro que siempre quisiste tener

        </h1>
        <p class="lead-copy max-w-3xl mx-auto mb-8" data-reveal style="--reveal-delay:150ms">
          Donde el silencio suena. Donde tus alumnos brillan. Donde tu aula se transforma desde la música, el vínculo y la neurociencia. Todo cambia cuando dejas de buscar resultados inmediatos. El aprendizaje no siempre hace ruido. El tiempo también enseña. No ofrecemos más recursos para hacer más cosas, ofrecemos herramientas para entender lo que ya está ocurriendo.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4" data-reveal style="--reveal-delay:220ms">
          <Button id="home-hero-reserve" href="/registro?source=home_hero" size="lg" variant="primary" class="cta-breathe">
            Quiero reservar mi plaza
          </Button>
          <a href="/#curso" class="btn btn-secondary btn-lg">Ver programa certificado</a>
        </div>

        <p class="sales-note mt-8" data-reveal style="--reveal-delay:280ms">
          Próxima edición: <span class="ink-underline-subtle">plazas limitadas a {COURSE_SEAT_LIMIT} docentes</span>. Ideal para docentes de niños y niñas de 0 a 6 años.
        </p>
        <p id="home-launch-status" class="sales-note mt-2" data-reveal style="--reveal-delay:320ms"></p>
      </div>
    </section>

    <section id="newsletter" class="section-shell section-tone-ivory">
      <div class="content-shell">
        <div class="newsletter-band newsletter-band-stacked space-y-7" data-reveal>
          <div class="space-y-4 max-w-none">
            <p class="editorial-kicker mb-3">Newsletter semanal</p>
            <h2 class="headline-luxe headline-rhythm-soft text-4xl md:text-5xl mb-3">
              Una pausa de pensamiento y aprendizaje lento a la semana,
              <span class="ink-underline">sin ruido.</span>
            </h2>
            <p class="lead-copy">
              Si aún no es tu momento de apuntarte al curso, déjanos tu email y recibe nuestra newsletter sobre neurodesarrollo y música cada semana. 
            </p>
          </div>
          <div>
            <NewsletterForm source="home_newsletter" variant="inline" ctaLabel="Apuntarme" />
          </div>
        </div>
      </div>
    </section>

    <section id="curso" class="section-shell">
      <div class="content-shell">
        <div class="max-w-3xl mb-14 md:mb-16" data-reveal>
          <p class="editorial-kicker mb-4">La formacion</p>
          <h2 class="headline-luxe section-title mb-5">
            Lo que deseas para tu aula
            <span class="ink-underline-subtle">si se puede entrenar</span>.
          </h2>
          <p class="lead-copy">
            No es solo teoria. Es una metodologia para ordenar la clase desde el ritmo, el vinculo y la atencion.
            Menos caos, mas presencia y aprendizaje que si se sostiene en el tiempo. Formación para docentes que quieren entender que ocurre cuando aparentamente no ocurre nada
          </p>
        </div>

        <div class="module-list">
          {moduleRows.map((row, index) => (
            <article class="module-row" data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <span class="module-index">{row.id}</span>
              <h3>{row.title}</h3>
              <p>{row.description}</p>
            </article>
          ))}
        </div>

        <div class="pt-9 md:pt-11 text-center" data-reveal style="--reveal-delay:460ms">
          <a href="/programa-completo.pdf" class="program-pdf-link" download>
            Descargar programa completo en PDF
          </a>
        </div>
      </div>
    </section>

    <section id="quienes" class="section-shell section-tone-ivory">
      <div class="content-shell">
        <div class="grid lg:grid-cols-12 gap-10 md:gap-12 items-start">
          <div class="lg:col-span-7 space-y-5" data-reveal>
            <p class="editorial-kicker">Quienes somos</p>
            <h2 class="headline-luxe section-title">
              Una escuela para docentes que quieren
              <span class="ink-underline">impacto real</span> y sensibilidad.
            </h2>
            <p class="lead-copy">
              Unimos neuroeducacion, musica y pedagogia aplicada para ayudarte a sostener clases mas profundas, disfrutables y efectivas.
            </p>
          </div>

          <div class="lg:col-span-5 who-list" data-reveal style="--reveal-delay:120ms">
            <p>Metodo claro para 0-6 y adaptable a 0-9.</p>
            <p>Aplicacion inmediata en contexto real.</p>
            <p>Formacion premium con acompanamiento humano.</p>
            <div class="pt-3">
              <Button href="/azahara-mateos" size="md" variant="secondary">Conocer a la directora</Button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="precio" class="section-shell">
      <div class="content-shell max-w-4xl">
        <div class="price-shell" data-reveal>
          <div class="text-center mb-10">
            <p class="editorial-kicker mb-4">Inversion en tu futuro docente</p>
            <h2 class="headline-luxe headline-rhythm-soft section-title mb-5">La formacion.</h2>
            <p class="font-display text-6xl md:text-7xl text-note mb-2">{COURSE_LAUNCH_PRICE_EUR} EUR</p>
            <p class="text-[11px] uppercase tracking-[0.2em] text-ink/54">
              Oferta lanzamiento . luego {COURSE_STANDARD_PRICE_EUR} EUR
            </p>
            <p class="mt-3 text-xs uppercase tracking-[0.14em] text-ink/58">
              Cierre automatico: 12 abril 2026 . 23:59 (Europe/Madrid)
            </p>
          </div>

          <div class="max-w-2xl mx-auto">
            {formationFeatures.map((feature, index) => (
              <div class={`formation-item ${index === formationFeatures.length - 1 ? '!border-b-0' : ''}`}>
                <span class="text-base md:text-[18px] text-ink/78">{feature}</span>
                <span class="check-soft text-xl text-moss">&#10003;</span>
              </div>
            ))}
          </div>

          <div class="text-center pt-10">
            <Button id="home-price-reserve" href="/registro?source=home_precio" size="lg" variant="primary" class="cta-breathe">
              Reservar mi plaza - {COURSE_LAUNCH_PRICE_EUR} EUR
            </Button>
            <p class="mt-5 text-sm text-ink/54 italic">
              Garantia de 14 dias. Maximo {COURSE_SEAT_LIMIT} plazas por curso. Si no encaja contigo, devolvemos la inversion.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="faq" class="section-shell section-tone-ivory">
      <div class="content-shell max-w-4xl">
        <div class="price-shell" data-reveal>
          <div class="text-center mb-8">
            <p class="editorial-kicker mb-3">Preguntas frecuentes</p>
            <h2 class="headline-luxe section-title">FAQ</h2>
          </div>

          <div>
            {faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0} data-reveal style={`--reveal-delay:${index * 70}ms`}>
                <summary>{faq.question}</summary>
                <p class="mt-3 text-ink/78 leading-relaxed text-base md:text-lg">{faq.answer}</p>
              </details>
            ))}
          </div>

          <div class="text-center pt-10">
            <p class="lead-copy max-w-3xl mx-auto mb-7">
              Tu aula puede sonar distinta desde este mes. Reserva tu plaza y entra en la primera edicion de la Escuela.
            </p>
            <Button id="home-faq-reserve" href="/registro?source=home_faq_cta" size="lg" variant="primary" class="cta-breathe">
              Reservar plaza
            </Button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    async function syncLaunchStatus() {
      const statusNode = document.getElementById('home-launch-status');
      const reserveLinks = [
        document.getElementById('home-hero-reserve'),
        document.getElementById('home-price-reserve'),
        document.getElementById('home-faq-reserve'),
      ].filter(Boolean);

      if (!statusNode || !reserveLinks.length) return;

      try {
        const response = await fetch('/api/launch/status');
        const payload = await response.json();

        if (!response.ok || !payload) return;

        const closeDate = new Date(payload.closesAtIso);
        const closeLabel = new Intl.DateTimeFormat('es-ES', {
          day: '2-digit',
          month: 'short',
          hour: '2-digit',
          minute: '2-digit',
          timeZone: 'Europe/Madrid',
        }).format(closeDate);

        if (payload.open) {
          statusNode.textContent = `Plazas disponibles: ${payload.seatsLeft}/${payload.seatLimit}. Cierre previsto: ${closeLabel}.`;
          return;
        }

        statusNode.textContent = payload.soldOut
          ? 'Convocatoria completa. Puedes entrar a la newsletter para la siguiente cohorte.'
          : 'Convocatoria cerrada por fecha. Entra en la newsletter para la proxima apertura.';

        reserveLinks.forEach((node) => {
          if (!(node instanceof HTMLAnchorElement)) return;
          node.href = '/#newsletter';
          node.textContent = 'Quiero entrar en la newsletter';
        });
      } catch (_error) {
        statusNode.textContent = '';
      }
    }

    syncLaunchStatus();
  </script>
</Layout>


