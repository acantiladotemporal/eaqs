---
import LearningShell from '../components/LearningShell.astro';
import { INITIAL_COHORT_ID, madridDate, formNotice } from '../components/learning';
const { db, user, enrollment } = Astro.locals;
if (!db || !user) return Astro.redirect('/login');
const cohortId = enrollment?.cohort_id || INITIAL_COHORT_ID;
const topicResult = await db.from('forum_topics').select('id,title,body,author_id,created_at').eq('cohort_id', cohortId).eq('hidden', false).order('created_at', { ascending: false }).limit(50);
const topics = topicResult.data || [];
const replyResult = topics.length ? await db.from('forum_replies').select('id,topic_id,body,author_id,created_at').in('topic_id', topics.map((topic) => topic.id)).eq('hidden', false).order('created_at') : { data: [], error: null };
const notice = formNotice(Astro.url);
---
<LearningShell title="Conversaciones que acompañan." eyebrow="Comunidad de tu cohorte" description="Un lugar para preguntar, escuchar y compartir lo que sucede en tu práctica docente.">
  {notice && <p class={`notice ${notice.kind}`} role="status">{notice.message}</p>}
  <p class="notice">Cuida la privacidad de las personas. Comparte situaciones de aula sin nombres, imágenes ni datos que permitan identificar a niños y niñas.</p>
  <details class="panel new-topic section"><summary>Abrir una conversación <span aria-hidden="true">＋</span></summary>
    <form action="/api/learning/action" method="post" class="stack">
      <input type="hidden" name="action" value="create_topic" /><input type="hidden" name="return_to" value="/foro" />
      <div class="field"><label for="topic-title">Título</label><input id="topic-title" name="title" minlength="5" maxlength="160" required /></div>
      <div class="field"><label for="topic-body">¿Qué quieres compartir?</label><textarea id="topic-body" name="body" rows={5} minlength="10" maxlength="5000" required></textarea></div>
      <div><button class="button" type="submit">Publicar conversación</button></div>
    </form>
  </details>
  {topicResult.error || replyResult.error ? <p class="notice error">No hemos podido cargar las conversaciones. Inténtalo de nuevo más tarde.</p> : topics.length ? <section class="stack section" aria-label="Conversaciones">
    {topics.map((topic) => <article class="panel topic" id={`tema-${topic.id}`}>
      <p class="eyebrow">{topic.author_id === user.id ? 'Tu conversación' : 'Una voz de tu cohorte'} · {madridDate(topic.created_at)}</p><h2>{topic.title}</h2><p class="preserve-lines">{topic.body}</p>
      <div class="replies">{(replyResult.data || []).filter((reply) => reply.topic_id === topic.id).map((reply) => <article class="reply"><p class="muted">{reply.author_id === user.id ? 'Tu respuesta' : 'Respuesta del grupo'} · {madridDate(reply.created_at)}</p><p class="preserve-lines">{reply.body}</p></article>)}</div>
      <details><summary>Responder a esta conversación</summary><form action="/api/learning/action" method="post" class="stack reply-form">
        <input type="hidden" name="action" value="reply_topic" /><input type="hidden" name="topic_id" value={topic.id} /><input type="hidden" name="return_to" value={`/foro#tema-${topic.id}`} />
        <div class="field"><label for={`reply-${topic.id}`}>Tu respuesta</label><textarea id={`reply-${topic.id}`} name="body" rows={3} maxlength="5000" minlength="3" required></textarea></div><div><button class="button button-secondary" type="submit">Enviar respuesta</button></div>
      </form></details>
    </article>)}
  </section> : <section class="empty-state section"><h2>La primera conversación empieza contigo.</h2><p>Comparte una pregunta o una observación para abrir el intercambio del grupo.</p></section>}
</LearningShell>
<style>
.new-topic summary{font-size:1.3rem;cursor:pointer}.new-topic summary span{float:right}.new-topic[open] summary{margin-bottom:2rem}.topic h2{font-size:2rem}.preserve-lines{white-space:pre-line;overflow-wrap:anywhere}.replies{margin:2rem 0}.reply{border-left:2px solid var(--ochre);padding:.25rem 0 .25rem 1.5rem;margin:1.5rem 0}.reply-form{margin-top:1.5rem}summary{cursor:pointer}
</style>

