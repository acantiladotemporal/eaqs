---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { safeNext } from '../lib/server/security';
const sent = Astro.url.searchParams.has('sent');
const failure = Astro.url.searchParams.get('error');
const next = safeNext(Astro.url.searchParams.get('next'));
---
<Layout title="Acceso | El Árbol Que Suena" description="Accede a tu solicitud y a tu aula con un enlace privado enviado a tu correo." experience="focused">
  <Header mode="focused" />
  <main id="main-content" class="section shell">
    <div class="access-layout">
      <header class="page-heading"><p class="eyebrow">Tu espacio en la escuela</p><h1 class="display">Volver a<br/><em><span class="editorial-accent">escuchar.</span></em></h1><p class="lead">Tu solicitud, tus clases y tu comunidad, en un mismo lugar.</p><p class="muted">Te enviaremos un enlace privado de acceso. No necesitas recordar una contraseña.</p></header>
      <section class="panel stack">
        <h2>Accede con tu correo</h2>
        {sent && <p class="notice" role="status">Si el correo es válido, recibirás un enlace para entrar. Revisa también la carpeta de correo no deseado.</p>}
        {failure && <p class="notice" role="alert">{failure === 'expired' ? 'El enlace ha caducado o ya se ha utilizado. Solicita uno nuevo.' : 'Ahora mismo no podemos enviar el enlace. Inténtalo más tarde o contacta con la escuela.'}</p>}
        <form method="post" action="/api/auth/login" class="stack">
          <input type="hidden" name="next" value={next}/>
          <div class="field"><label for="access-email">Correo electrónico</label><input id="access-email" name="email" type="email" autocomplete="email" required maxlength="254"/></div>
          <div hidden aria-hidden="true"><label>Deja este campo vacío<input name="website" tabindex="-1" autocomplete="off"/></label></div>
          <button class="button" type="submit">Recibir enlace de acceso <span aria-hidden="true">↗</span></button>
        </form>
        <p class="muted">¿Aún no has solicitado tu plaza? <a href="/registro">Solicitar Plaza</a></p>
      </section>
    </div>
  </main>
  <Footer mode="focused" />
</Layout>
