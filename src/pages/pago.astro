---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Redirigiendo | El Arbol Que Suena" description="Redireccion a la pagina de reserva.">
  <main class="bg-white min-h-screen flex items-center justify-center px-6 py-20">
    <section class="ui-panel w-full max-w-xl p-8 md:p-10 text-center space-y-5" data-reveal>
      <p class="editorial-kicker">Unificacion del flujo</p>
      <h1 class="headline-luxe text-4xl md:text-5xl">Redirigiendo a reserva</h1>
      <p class="lead-copy">Todo el proceso de compra ahora se realiza en un solo paso.</p>
      <a href="/registro" class="btn btn-lg btn-primary w-full">Ir a reservar plaza</a>
    </section>
  </main>

  <script>
    window.setTimeout(() => {
      window.location.replace('/registro');
    }, 120);
  </script>
</Layout>
