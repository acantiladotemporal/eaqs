---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Gracias | El Arbol Que Suena" description="Tu solicitud se ha recibido correctamente.">
  <Header />
  <main class="bg-white min-h-screen pt-40 pb-24 px-6">
    <section class="max-w-3xl mx-auto ui-panel p-10 md:p-16 text-center" data-reveal>
      <p class="font-sans text-[10px] uppercase tracking-[0.35em] text-moss font-bold mb-5">Pago confirmado</p>
      <h1 class="font-display text-6xl md:text-7xl italic mb-8">Tu plaza esta reservada.</h1>
      <p class="font-sans text-lg text-ink/70 leading-relaxed">
        Te hemos enviado confirmacion de compra y un segundo email con acceso a tu perfil privado de alumno.
      </p>
      <p class="font-sans text-sm text-ink/62 leading-relaxed mt-4 max-w-2xl mx-auto">
        Al entrar veras los modulos todavia sin activar, listos para abrirse segun el calendario de la edicion.
      </p>
      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <a href="/login?next=/dashboard" class="btn btn-md btn-primary">Entrar a mi perfil</a>
        <a href="/contacto" class="btn btn-md btn-secondary">Contactar soporte</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
