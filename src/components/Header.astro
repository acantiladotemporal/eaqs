---
import BrandLockup from './BrandLockup.astro';
import MobileEnrollmentBar from './MobileEnrollmentBar.astro';
interface Props { mode?: 'default' | 'learning' | 'focused'; preview?: boolean; }
const learning = Astro.props.mode === 'learning';
const focused = Astro.props.mode === 'focused';
const preview = import.meta.env.DEV && Astro.props.preview;
const items = [['/programa', 'La Formación'], ['/escuela-internacional-neuroeducacion-musical', 'La Escuela'], ['/contacto', 'Contacto']];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = (href: string) => path === href || (href === '/escuela-internacional-neuroeducacion-musical' && path === '/metodologia');
const capture = !learning && !focused && ['/', '/programa', '/escuela-internacional-neuroeducacion-musical', '/contacto'].includes(path);
---
<header class:list={['site-header', { 'header-learning': learning, 'header-focused': focused }]}>
  <nav class="shell header-inner" aria-label="Principal">
    <BrandLockup variant="header" />
    {!learning && !focused && <div class="desktop-nav">{items.map(([href, label]) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}</div>}
    <div class="header-actions">
      {learning ? <a class="learning-home-link" href={preview ? '/vista-previa' : '/'} aria-label={preview ? 'Mapa De Revisión De La Web' : 'Volver A La Web De La Escuela'}><span class="learning-home-full">{preview ? 'Recorrido Web' : 'Volver A La Web'}</span><span class="learning-home-short">{preview ? 'Mapa' : 'Web'}</span> <span aria-hidden="true">↗</span></a> : focused ? <a class="focused-context-link" href="/programa"><span>Ver La Formación</span><span aria-hidden="true">↗</span></a> : <>
        <a class="access-link" href="/login">Aula <span aria-hidden="true">↗</span></a>
        <a class="button button-small" href="/registro">Solicitar Plaza <span aria-hidden="true">↗</span></a>
        <details class="mobile-menu"><summary aria-label="Abrir navegación">Menú <span class="menu-indicator" aria-hidden="true">+</span></summary><div>{items.map(([href, label]) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}<a class="menu-access" href="/login">Acceso Al Aula <span aria-hidden="true">↗</span></a><a class="button" href="/registro">Solicitar Plaza <span aria-hidden="true">↗</span></a></div></details>
      </>}
    </div>
  </nav>
</header>
{capture && <MobileEnrollmentBar />}
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  if (menu) {
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
    });
    document.addEventListener('click', event => { if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false; });
  }
</script>
