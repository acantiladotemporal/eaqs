---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export const prerender = true;

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} | El Árbol Que Suena`}>
  <Header />
  
  <main class="bg-white text-ink pt-48 pb-32 px-6">
    <article class="max-w-[1800px] mx-auto">
      
      <!-- Cabecera del Artículo -->
      <header class="max-w-4xl mx-auto mb-24 text-center md:text-left">
        <div class="flex flex-col md:flex-row md:items-center gap-4 mb-8 justify-center md:justify-start font-sans text-[10px] uppercase tracking-[0.3em] font-bold text-moss">
            <span>{entry.data.pubDate.toLocaleDateString('es-ES', { dateStyle: 'long' })}</span>
            <span class="hidden md:block">•</span>
            <span>Por {entry.data.author}</span>
        </div>
        
        <h1 class="font-display text-5xl md:text-8xl italic tracking-tighter leading-[0.9] mb-12">
            {entry.data.title}
        </h1>
        
        <p class="font-display text-2xl text-ink/50 leading-relaxed italic max-w-2xl">
            {entry.data.description}
        </p>
      </header>

      <!-- Imagen Destacada -->
      <div class="max-w-7xl mx-auto mb-24 aspect-[21/9] overflow-hidden rounded-sm bg-clay/10">
        {entry.data.image && (
            <img src={entry.data.image} class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-1000" />
        )}
      </div>

      <!-- Contenido del Post -->
      <div class="max-w-2xl mx-auto">
        <div class="font-sans text-lg text-ink/80 leading-relaxed space-y-8 prose-custom">
            <Content />
        </div>

        <!-- Cierre del artículo -->
        <footer class="mt-32 pt-16 border-t border-clay/30">
            <div class="flex flex-col md:flex-row justify-between items-center gap-12">
                <a href="/blog" class="font-sans text-[10px] uppercase tracking-widest border-b border-ink pb-1 hover:text-moss hover:border-moss transition-all">
                    ← Volver al archivo
                </a>
                <div class="flex gap-6">
                    <span class="font-sans text-[10px] uppercase tracking-widest text-ink/30 font-bold">Compartir</span>
                    <!-- Aquí irían iconos simples de redes -->
                </div>
            </div>
        </footer>
      </div>

    </article>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* Estilos para el contenido Markdown/Prose */
  .prose-custom h2 {
    @apply font-display text-4xl italic text-ink mt-16 mb-8;
  }
  .prose-custom h3 {
    @apply font-display text-2xl italic text-ink mt-12 mb-6;
  }
  .prose-custom p {
    @apply mb-8;
  }
  .prose-custom ul {
    @apply space-y-4 mb-12 list-disc list-inside border-l border-moss pl-6;
  }
  .prose-custom strong {
    @apply text-ink font-bold;
  }
</style>
