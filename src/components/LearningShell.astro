---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
interface Props { title: string; eyebrow?: string; description?: string; admin?: boolean; preview?: boolean; }
const { title, eyebrow = 'El aula de El Árbol Que Suena', description, admin = false } = Astro.props;
const preview = import.meta.env.DEV && Astro.props.preview;
const previewPaths: Record<string, string> = { '/dashboard': '/vista-previa/aula', '/foro': '/vista-previa/comunidad', '/tutorias': '/vista-previa/tutorias', '/trabajo-final': '/vista-previa/trabajo-final', '/certificado': '/vista-previa/certificado', '/admin': '/vista-previa/administracion' };
const links = admin
  ? [['/admin', 'Resumen'], ['/admin?tab=solicitudes', 'Solicitudes'], ['/admin?tab=contenidos', 'Contenidos'], ['/admin?tab=trabajos', 'Trabajos'], ['/admin?tab=comunidad', 'Comunidad'], ['/admin?tab=tutorias', 'Tutorías'], ['/admin?tab=correo', 'Correo']]
  : [['/dashboard', 'Mi Itinerario'], ['/foro', 'Comunidad'], ['/tutorias', 'Tutorías'], ['/trabajo-final', 'Trabajo Final'], ['/certificado', 'Certificado']];
const navigation = links.map(([href, label]) => {
  const target = new URL(href, Astro.url);
  if (preview) target.pathname = previewPaths[target.pathname] || target.pathname;
  if (admin && Astro.url.searchParams.has('cohort')) target.searchParams.set('cohort', Astro.url.searchParams.get('cohort')!);
  const withinModule = href === '/dashboard' && ['/modulos/', '/examen/', '/vista-previa/modulo', '/vista-previa/cuestionario'].some(path => Astro.url.pathname.startsWith(path));
  const active = withinModule || (Astro.url.pathname === target.pathname && (Astro.url.searchParams.get('tab') || 'resumen') === (target.searchParams.get('tab') || 'resumen'));
  return { href: target.pathname + target.search, label, active };
});
---
<Layout title={`${title} | El Árbol Que Suena`} description={description || 'Espacio privado de aprendizaje de la Escuela Internacional de Neuroeducación Musical.'} noindex={preview} experience="learning">
  <Header mode="learning" preview={preview} />
  <main id="main-content" class="app-shell shell">
    {preview && <details class="notice review-notice"><summary>Demostración local · Datos de ejemplo</summary><p>Estas pantallas permiten revisar el diseño y las interacciones. Los cambios de prueba duran hasta recargar esta página. <a class="text-link" href="/vista-previa">Mapa De Toda La Web ↗</a></p></details>}
    <div class="learning-workspace">
      <aside class="course-sidebar">
        <details class="course-navigation" open data-course-navigation>
          <summary>{admin ? 'Menú De Gestión' : 'Menú Del Aula'} <span aria-hidden="true">+</span></summary>
          <div class="course-navigation-body">
            <p class="eyebrow">{admin ? 'La escuela' : 'Tu aula'}</p>
            <nav class="course-links" aria-label={admin ? 'Administración' : 'Aula'}>
              {navigation.map(({ href, label, active }, index) => <>
                {!admin && index === 3 && <p class="course-nav-divider">Al completar el recorrido</p>}
                <a href={href} aria-current={active ? 'page' : undefined}>{label}<span aria-hidden="true">{active ? '↗' : ''}</span></a>
              </>)}
            </nav>
            <div class="course-session">
              {preview ? <a class="text-button" href="/vista-previa">Salir De La Demostración</a> : <form action="/api/auth/logout" method="post"><button class="text-button" type="submit">Cerrar Sesión</button></form>}
            </div>
          </div>
        </details>
      </aside>
      <div class="learning-content">
        <header class="page-heading"><p class="eyebrow">{eyebrow}</p><h1 class="display">{title}</h1>{description && <p class="lead">{description}</p>}</header>
        <slot />
      </div>
    </div>
  </main>
  <Footer mode="learning" preview={preview} />
</Layout>
<script>
  const navigation = document.querySelector<HTMLDetailsElement>('[data-course-navigation]');
  if (navigation) {
    const desktop = window.matchMedia('(min-width: 1001px)');
    const resize = () => { navigation.open = desktop.matches; };
    resize();
    desktop.addEventListener('change', resize);
  }
</script>
<style>
  .learning-workspace{display:grid;grid-template-columns:200px minmax(0,1fr);gap:40px;align-items:start}
  .course-sidebar{position:sticky;top:24px}
  .course-navigation>summary{display:none}
  .course-navigation-body>.eyebrow{padding:0 12px;margin-bottom:16px}
  .course-links{display:grid;gap:4px}
  .course-links>a{display:flex;justify-content:space-between;align-items:center;gap:8px;min-height:48px;padding:12px;border-left:2px solid transparent;font-size:.88rem}
  .course-links>a:hover{background:var(--cream)}
  .course-links>a[aria-current=page]{background:var(--accent-tint);border-color:var(--ochre);font-weight:500}
  .course-nav-divider{border-top:1px solid var(--line);font-size:.67rem;line-height:1.6;color:var(--muted);margin-top:20px;padding:20px 12px 8px}
  .course-session{border-top:1px solid var(--line);margin-top:24px;padding:12px}
  .text-button{display:inline-flex;align-items:center;min-height:44px;font:inherit;font-size:.75rem;background:none;border:0;text-decoration:underline;text-underline-offset:.25em;cursor:pointer;color:var(--muted);padding:.5rem 0;text-align:left}
  .learning-content{min-width:0}
  .learning-content :global(.section){padding-block:32px}
  .learning-content>.page-heading{padding:0 0 28px}
  .learning-content>.page-heading h1{font-size:clamp(2.2rem,3.3vw,3.2rem);line-height:1.12;max-width:20ch}
  .learning-content>.page-heading .lead{margin-top:1rem;font-size:.98rem}
  .review-notice{margin-bottom:24px;padding:12px 16px;font-size:.78rem}
  .review-notice summary{cursor:pointer;min-height:24px}
  .review-notice p{margin-top:12px;max-width:65rem}
  .review-notice .text-link{font-size:.78rem;margin-left:.5rem}
  @media(max-width:1000px){
    .learning-workspace{grid-template-columns:minmax(0,1fr);gap:24px}
    .course-sidebar{position:static}
    .course-navigation{border:1px solid var(--line);background:var(--paper)}
    .course-navigation>summary{list-style:none;display:flex;justify-content:space-between;gap:1rem;align-items:center;min-height:52px;padding:12px 16px;font-size:.86rem}
    .course-navigation>summary::-webkit-details-marker{display:none}
    .course-navigation[open]>summary{border-bottom:1px solid var(--line)}
    .course-navigation[open]>summary>span{transform:rotate(45deg)}
    .course-navigation-body{padding:12px 4px 0}
    .course-navigation-body>.eyebrow{display:none}
    .course-nav-divider{margin-top:8px;padding-top:12px}
    .course-session{margin-top:12px;padding-block:4px}
  }
  @media print{.course-sidebar,.review-notice{display:none}.learning-workspace{display:block}.learning-content :global(.section){padding:1rem 0}}
</style>
