---
import LearningShell from '../../components/LearningShell.astro';
import { INITIAL_COHORT_ID, madridDate, formNotice, applicationLabels, submissionLabels } from '../../components/learning';
import { adminClient } from '../../lib/server/auth';
const { db, user, isAdmin } = Astro.locals;
if (!db || !user) return Astro.redirect('/login?next=/admin');
if (!isAdmin) return new Response('No autorizado.', { status: 403 });
const allowedTabs = ['resumen', 'solicitudes', 'contenidos', 'trabajos', 'comunidad', 'tutorias', 'correo'];
const requestedTab = Astro.url.searchParams.get('tab') || 'resumen';
const tab = allowedTabs.includes(requestedTab) ? requestedTab : 'resumen';
const cohortResult = await db.from('cohorts').select('*').order('created_at', { ascending: false });
const cohorts = cohortResult.data || [];
const requestedCohort = Astro.url.searchParams.get('cohort') || INITIAL_COHORT_ID;
const cohort = cohorts.find((item) => item.id === requestedCohort) || cohorts[0];
const cohortId = cohort?.id || INITIAL_COHORT_ID;
const returnTo = `/admin?tab=${tab}&cohort=${cohortId}`;
const notice = formNotice(Astro.url);
const [applicationsResult, enrollmentsResult] = await Promise.all([
  db.from('applications').select('*').eq('cohort_id', cohortId).order('created_at', { ascending: false }),
  db.from('enrollments').select('id,user_id,application_id,status,reference,paid_at,created_at').eq('cohort_id', cohortId).order('created_at', { ascending: false }),
]);
const applications = applicationsResult.data || [];
const enrollments = enrollmentsResult.data || [];
const modulesResult = tab === 'contenidos' ? await db.from('modules').select('*').eq('cohort_id', cohortId).order('position') : { data: [], error: null };
const modules = modulesResult.data || [];
const resourcesResult = modules.length ? await db.from('resources').select('id,module_id,title,kind').in('module_id', modules.map((item) => item.id)) : { data: [], error: null };
const quizResult = modules.length ? await db.from('quiz_questions').select('id,module_id,prompt,options').in('module_id', modules.map((item) => item.id)) : { data: [], error: null };
const assignmentsResult = ['contenidos', 'trabajos'].includes(tab) ? await db.from('assignments').select('*').eq('cohort_id', cohortId).order('created_at', { ascending: false }) : { data: [], error: null };
const assignments = assignmentsResult.data || [];
const submissionsResult = tab === 'trabajos' && assignments.length ? await db.from('submissions').select('*').in('assignment_id', assignments.map((item) => item.id)).order('created_at', { ascending: false }) : { data: [], error: null };
const topicsResult = tab === 'comunidad' ? await db.from('forum_topics').select('*').eq('cohort_id', cohortId).order('created_at', { ascending: false }).limit(100) : { data: [], error: null };
const repliesResult = topicsResult.data?.length ? await db.from('forum_replies').select('*').in('topic_id', topicsResult.data.map((item) => item.id)).order('created_at') : { data: [], error: null };
const tutoringResult = tab === 'tutorias' ? await db.from('tutoring_sessions').select('*').eq('cohort_id', cohortId).order('starts_at') : { data: [], error: null };
const profilesResult = ['trabajos', 'resumen'].includes(tab) ? await db.from('profiles').select('id,full_name') : { data: [], error: null };
const nameFor = (id: string) => profilesResult.data?.find((profile) => profile.id === id)?.full_name || 'Participante';
interface OutboxRow { id: string; recipient: string; subject: string; status: string; attempts: number; created_at: string; last_error: string | null; }
let outboxResult: { data: OutboxRow[] | null; error: unknown } = { data: [], error: null };
interface NewsletterRow { id: string; email: string; status: string; provider_sync_status: string; provider_synced_at: string | null; unsubscribed_at: string | null; }
let newsletterResult: { data: NewsletterRow[] | null; error: unknown } = { data: [], error: null };
if (tab === 'correo') {
  try { outboxResult = await adminClient().from('email_outbox').select('id,recipient,subject,status,attempts,created_at,last_error').order('created_at', { ascending: false }).limit(100); }
  catch (error) { outboxResult = { data: [], error }; }
  try { newsletterResult = await adminClient().from('newsletter_subscribers').select('id,email,status,provider_sync_status,provider_synced_at,unsubscribed_at').or('status.neq.pending,unsubscribed_at.not.is.null').order('provider_sync_status').order('created_at', { ascending: false }).limit(100); }
  catch (error) { newsletterResult = { data: [], error }; }
}
const failed = cohortResult.error || applicationsResult.error || enrollmentsResult.error || modulesResult.error || resourcesResult.error || quizResult.error || assignmentsResult.error || submissionsResult.error || topicsResult.error || repliesResult.error || tutoringResult.error || profilesResult.error || outboxResult.error || newsletterResult.error;
---
<LearningShell title="Cuidar la escuela, por dentro." eyebrow="Administración" admin description="Solicitudes, contenidos y acompañamiento de cada cohorte.">
  {notice && <p class={`notice ${notice.kind}`} role="status">{notice.message}</p>}
  <form method="get" action="/admin" class="cohort-selector field"><input type="hidden" name="tab" value={tab} /><label for="admin-cohort">Cohorte</label><div class="inline-form"><select id="admin-cohort" name="cohort">{cohorts.map((item) => <option value={item.id} selected={item.id === cohortId}>{item.title}</option>)}</select><button class="button button-secondary" type="submit">Seleccionar</button></div></form>
  {failed && <p class="notice error" role="alert">No se ha podido cargar parte del panel. Comprueba la conexión y vuelve a intentarlo antes de realizar cambios.</p>}
  {tab === 'resumen' && <>
    <section class="admin-metrics section" aria-label="Resumen de la cohorte"><article class="panel"><p class="eyebrow">Solicitudes por revisar</p><p class="metric">{applications.filter((item) => item.status === 'submitted').length}</p></article><article class="panel"><p class="eyebrow">Matrículas confirmadas</p><p class="metric">{enrollments.filter((item) => item.status === 'active').length}<span>/{cohort?.seat_limit || 20}</span></p></article><article class="panel"><p class="eyebrow">Pendientes de pago</p><p class="metric">{enrollments.filter((item) => item.status === 'pending_payment').length}</p></article></section>
    <section class="panel stack section"><h2>Convocatoria y calendario</h2><form method="post" action="/api/admin/action" class="stack"><input type="hidden" name="action" value="save_cohort" /><input type="hidden" name="cohort_id" value={cohortId} /><input type="hidden" name="return_to" value={returnTo} /><div class="field"><label for="cohort-title">Nombre de la cohorte</label><input id="cohort-title" name="title" value={cohort?.title || ''} maxlength="160" required /></div><div class="field"><label for="cohort-start">Fecha de inicio (opcional)</label><input id="cohort-start" name="start_at" value={cohort?.start_at || ''} placeholder="2027-03-01T09:00:00+01:00" /><p class="muted">Usa una fecha ISO con zona horaria. Si no está confirmada, deja el campo vacío.</p></div><label class="check-field"><input type="checkbox" name="applications_open" checked={cohort?.applications_open} /> Admitir solicitudes para esta cohorte</label><div><button class="button" type="submit">Guardar convocatoria</button></div></form></section>
    <section class="section stack"><h2>Alumnado y matrículas</h2><p class="notice">El cobro se habilitará en la última fase. Aceptar una solicitud no confirma una matrícula ni activa el aula.</p>{enrollments.length ? <div class="table-wrap"><table><thead><tr><th>Participante</th><th>Estado</th><th>Referencia</th><th>Confirmación</th></tr></thead><tbody>{enrollments.map((item) => <tr><td>{applications.find((application) => application.id === item.application_id)?.full_name || nameFor(item.user_id)}</td><td>{item.status === 'active' ? 'Confirmada' : item.status === 'pending_payment' ? 'Pendiente de pago' : item.status === 'refunded' ? 'Reembolsada' : 'Cancelada'}</td><td><code>{item.reference}</code></td><td>{item.paid_at ? madridDate(item.paid_at) : '—'}</td></tr>)}</tbody></table></div> : <p class="empty-state">Todavía no hay matrículas en esta cohorte.</p>}</section>
  </>}
  {tab === 'solicitudes' && <section class="section stack"><h2>Solicitudes de admisión</h2>{applications.length ? applications.map((application) => <article class="panel stack"><div class="item-heading"><div><p class="eyebrow">{madridDate(application.created_at)}</p><h3>{application.full_name}</h3><p><a href={`mailto:${application.email}`}>{application.email}</a> · {application.country}</p></div><span class="status">{applicationLabels[application.status] || application.status}</span></div><dl class="application-details"><div><dt>Perfil profesional</dt><dd>{application.role}</dd></div><div><dt>Etapa educativa</dt><dd>{application.age_range}</dd></div><div><dt>Motivación</dt><dd class="preserve-lines">{application.motivation}</dd></div></dl><form method="post" action="/api/admin/action" class="inline-form"><input type="hidden" name="action" value="review_application" /><input type="hidden" name="application_id" value={application.id} /><input type="hidden" name="return_to" value={returnTo} /><div class="field"><label for={`status-${application.id}`}>Decisión</label><select id={`status-${application.id}`} name="status"><option value="submitted" selected={application.status === 'submitted'}>En revisión</option><option value="accepted" selected={application.status === 'accepted'}>Aceptar · pendiente de pago</option><option value="waitlisted" selected={application.status === 'waitlisted'}>Lista de espera</option><option value="rejected" selected={application.status === 'rejected'}>No aceptar</option></select></div><button type="submit" class="button button-secondary">Guardar decisión</button></form></article>) : <p class="empty-state">No hay solicitudes en esta cohorte.</p>}</section>}
  {tab === 'contenidos' && <section class="section stack"><h2>El itinerario de la cohorte</h2><p class="notice">Publica un módulo solo cuando su contenido y cuestionario estén preparados. Sin fecha de apertura permanecerá cerrado para el alumnado.</p>{modules.length ? modules.map((module) => <details class="panel module-editor"><summary><span>{String(module.position).padStart(2, '0')} · {module.title}</span><span class="status">{module.published ? 'Publicado' : 'Borrador'}</span></summary><div class="editor-body stack">
    <form method="post" action="/api/admin/action" class="stack"><input type="hidden" name="action" value="save_module" /><input type="hidden" name="module_id" value={module.id} /><input type="hidden" name="return_to" value={returnTo} /><div class="field"><label for={`title-${module.id}`}>Título</label><input id={`title-${module.id}`} name="title" value={module.title} maxlength="180" required /></div><div class="field"><label for={`summary-${module.id}`}>Resumen</label><textarea id={`summary-${module.id}`} name="summary" rows={2} maxlength="1000">{module.summary}</textarea></div><div class="field"><label for={`body-${module.id}`}>Contenido de la lección</label><textarea id={`body-${module.id}`} name="body" rows={10} maxlength="50000">{module.body}</textarea><p class="muted">Texto sin formato. Separa los párrafos con una línea vacía.</p></div><div class="field"><label for={`unlock-${module.id}`}>Apertura (ISO con zona horaria)</label><input id={`unlock-${module.id}`} name="unlock_at" value={module.unlock_at || ''} placeholder="2027-03-01T09:00:00+01:00" /></div><label class="check-field"><input type="checkbox" name="published" checked={module.published} /> Publicar este módulo</label><div><button class="button" type="submit">Guardar módulo</button></div></form>
    <section class="editor-section stack"><h3>Materiales</h3>{(resourcesResult.data || []).filter((resource) => resource.module_id === module.id).map((resource) => <p><a href={`/api/materials/${resource.id}`}>{resource.title}</a><span class="muted"> · {resource.kind === 'video' ? 'Vídeo' : 'Documento'}</span></p>)}<form method="post" action="/api/admin/action" enctype="multipart/form-data" class="stack"><input type="hidden" name="action" value="save_resource" /><input type="hidden" name="module_id" value={module.id} /><input type="hidden" name="return_to" value={returnTo} /><div class="grid-2"><div class="field"><label for={`resource-title-${module.id}`}>Nombre del material</label><input id={`resource-title-${module.id}`} name="title" maxlength="180" required /></div><div class="field"><label for={`resource-kind-${module.id}`}>Tipo</label><select id={`resource-kind-${module.id}`} name="kind"><option value="document">Documento PDF</option><option value="video">Vídeo MP4 / WebM</option></select></div></div><div class="field"><label for={`resource-provider-${module.id}`}>Dónde está el material</label><select id={`resource-provider-${module.id}`} name="storage_provider"><option value="supabase">Subir documento privado</option><option value="r2">Archivo ya cargado en R2</option></select></div><div class="field"><label for={`resource-path-${module.id}`}>Ruta del archivo en R2</label><input id={`resource-path-${module.id}`} name="storage_path" maxlength="1024" placeholder={`${module.id}/clase.mp4`} /><p class="muted">Solo para archivos ya cargados en R2. La ruta debe comenzar por el identificador de este módulo: {module.id}/. No incluyas una URL.</p></div><div class="field"><label for={`resource-file-${module.id}`}>Documento PDF para subir</label><input id={`resource-file-${module.id}`} name="file" type="file" accept="application/pdf" /><p class="muted">Para la subida privada, adjunta un PDF de hasta 10 MB. El vídeo se prepara y carga en R2 antes de añadir su ruta.</p></div><div><button class="button button-secondary" type="submit">Añadir material</button></div></form></section>
    <section class="editor-section stack"><h3>Cuestionario de participación</h3>{(quizResult.data || []).filter((question) => question.module_id === module.id).map((question) => <form method="post" action="/api/admin/action" class="stack quiz-editor"><input type="hidden" name="action" value="save_quiz" /><input type="hidden" name="module_id" value={module.id} /><input type="hidden" name="question_id" value={question.id} /><input type="hidden" name="return_to" value={returnTo} /><div class="field"><label for={`question-${question.id}`}>Pregunta</label><textarea id={`question-${question.id}`} name="prompt" rows={2} maxlength="1500" required>{question.prompt}</textarea></div><div class="field"><label for={`options-${question.id}`}>Opciones, una por línea; vacío para reflexión</label><textarea id={`options-${question.id}`} name="options" rows={3} maxlength="5000">{Array.isArray(question.options) ? question.options.join('\n') : ''}</textarea></div><div><button class="button button-secondary" type="submit">Guardar pregunta</button></div></form>)}<details><summary>Añadir una pregunta</summary><form method="post" action="/api/admin/action" class="stack editor-body"><input type="hidden" name="action" value="save_quiz" /><input type="hidden" name="module_id" value={module.id} /><input type="hidden" name="return_to" value={returnTo} /><div class="field"><label for={`question-new-${module.id}`}>Pregunta</label><textarea id={`question-new-${module.id}`} name="prompt" rows={2} maxlength="1500" required></textarea></div><div class="field"><label for={`options-new-${module.id}`}>Opciones, una por línea; vacío para reflexión</label><textarea id={`options-new-${module.id}`} name="options" rows={3} maxlength="5000"></textarea></div><div><button class="button button-secondary" type="submit">Añadir pregunta</button></div></form></details></section>
  </div></details>) : <p class="empty-state">Todavía no hay módulos preparados en esta cohorte.</p>}
  <section class="panel stack"><h2>Propuesta de trabajo final</h2>{assignments.length > 0 && <p class="muted">La última propuesta publicada es «{assignments[0].title}».</p>}<form method="post" action="/api/admin/action" class="stack"><input type="hidden" name="action" value="save_assignment" /><input type="hidden" name="cohort_id" value={cohortId} /><input type="hidden" name="return_to" value={returnTo} />{assignments[0] && <input type="hidden" name="assignment_id" value={assignments[0].id} />}<div class="field"><label for="assignment-title">Título</label><input id="assignment-title" name="title" value={assignments[0]?.title || ''} maxlength="180" required /></div><div class="field"><label for="assignment-instructions">Instrucciones</label><textarea id="assignment-instructions" name="instructions" rows={8} maxlength="20000" required>{assignments[0]?.instructions || ''}</textarea></div><label class="check-field"><input type="checkbox" name="published" checked={assignments[0]?.published} /> Publicar la propuesta de trabajo final</label><div><button type="submit" class="button">Guardar trabajo final</button></div></form></section></section>}
  {tab === 'trabajos' && <section class="section stack"><h2>Entregas del trabajo final</h2>{submissionsResult.data?.length ? submissionsResult.data.map((submission) => <article class="panel stack"><p class="eyebrow">{madridDate(submission.created_at)} · {submissionLabels[submission.status] || submission.status}</p><h3>{nameFor(submission.user_id)}</h3><p class="preserve-lines">{submission.content}</p>{submission.storage_path && <a href={`/api/submissions/${submission.id}`}>Descargar documento adjunto ↓</a>}<form method="post" action="/api/admin/action" class="stack"><input type="hidden" name="action" value="review_submission" /><input type="hidden" name="submission_id" value={submission.id} /><input type="hidden" name="return_to" value={returnTo} /><div class="field"><label for={`review-status-${submission.id}`}>Revisión</label><select id={`review-status-${submission.id}`} name="status"><option value="submitted" selected={submission.status === 'submitted'}>Pendiente de revisión</option><option value="revision_requested" selected={submission.status === 'revision_requested'}>Solicitar revisión</option><option value="approved" selected={submission.status === 'approved'}>Aprobar trabajo</option></select></div><div class="field"><label for={`review-feedback-${submission.id}`}>Devolución para el participante</label><textarea id={`review-feedback-${submission.id}`} name="feedback" rows={4} maxlength="10000">{submission.feedback || ''}</textarea></div><div><button type="submit" class="button button-secondary">Guardar revisión</button></div></form>{submission.status === 'approved' && <form method="post" action="/api/admin/action"><input type="hidden" name="action" value="issue_certificate" /><input type="hidden" name="user_id" value={submission.user_id} /><input type="hidden" name="cohort_id" value={cohortId} /><input type="hidden" name="return_to" value={returnTo} /><p class="muted">La emisión comprobará también la participación en los diez módulos.</p><button type="submit" class="button">Emitir certificado propio</button></form>}</article>) : <p class="empty-state">Todavía no se han recibido trabajos finales.</p>}</section>}
  {tab === 'comunidad' && <section class="section stack"><h2>Moderación de la comunidad</h2>{topicsResult.data?.length ? topicsResult.data.map((topic) => <article class="panel stack"><p class="eyebrow">{madridDate(topic.created_at)} · {topic.hidden ? 'Oculta' : 'Visible'}</p><h3>{topic.title}</h3><p class="preserve-lines">{topic.body}</p><form method="post" action="/api/admin/action"><input type="hidden" name="action" value="moderate_topic" /><input type="hidden" name="topic_id" value={topic.id} /><input type="hidden" name="hidden" value={topic.hidden ? 'false' : 'true'} /><input type="hidden" name="return_to" value={returnTo} /><button class="button button-secondary" type="submit">{topic.hidden ? 'Volver a mostrar' : 'Ocultar conversación'}</button></form>{(repliesResult.data || []).filter((reply) => reply.topic_id === topic.id).map((reply) => <div class="moderation-reply"><p class="muted">Respuesta · {reply.hidden ? 'Oculta' : 'Visible'} · {madridDate(reply.created_at)}</p><p class="preserve-lines">{reply.body}</p><form method="post" action="/api/admin/action"><input type="hidden" name="action" value="moderate_reply" /><input type="hidden" name="reply_id" value={reply.id} /><input type="hidden" name="hidden" value={reply.hidden ? 'false' : 'true'} /><input type="hidden" name="return_to" value={returnTo} /><button class="button button-secondary" type="submit">{reply.hidden ? 'Mostrar respuesta' : 'Ocultar respuesta'}</button></form></div>)}</article>) : <p class="empty-state">Todavía no hay conversaciones que moderar.</p>}</section>}
  {tab === 'tutorias' && <section class="section stack"><h2>Encuentros de acompañamiento</h2>{tutoringResult.data?.map((session) => <article class="panel"><p class="eyebrow">{madridDate(session.starts_at, true)} · Madrid</p><h3>{session.title}</h3><p class="preserve-lines">{session.notes}</p></article>)}<form method="post" action="/api/admin/action" class="panel stack"><input type="hidden" name="action" value="save_tutoring" /><input type="hidden" name="cohort_id" value={cohortId} /><input type="hidden" name="return_to" value={returnTo} /><h3>Programar un encuentro</h3><div class="field"><label for="tutoring-title">Título</label><input id="tutoring-title" name="title" maxlength="180" required /></div><div class="field"><label for="tutoring-start">Fecha y hora (ISO con zona horaria)</label><input id="tutoring-start" name="starts_at" placeholder="2027-03-01T18:00:00+01:00" required /></div><div class="field"><label for="tutoring-url">Enlace del encuentro (opcional)</label><input id="tutoring-url" name="meeting_url" type="url" placeholder="https://" /></div><div class="field"><label for="tutoring-notes">Indicaciones para el grupo</label><textarea id="tutoring-notes" name="notes" rows={4} maxlength="5000"></textarea></div><div><button class="button" type="submit">Publicar encuentro</button></div></form></section>}
  {tab === 'correo' && <section class="section stack"><h2>Mensajes de la escuela</h2><p class="muted">Estado de los últimos 100 mensajes. Reintentar un envío no cambia una matrícula ni una solicitud.</p>{outboxResult.data?.length ? <div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Destinatario y asunto</th><th>Estado</th><th>Intentos</th><th>Acción</th></tr></thead><tbody>{outboxResult.data.map((email) => <tr><td>{madridDate(email.created_at, true)}</td><td>{email.recipient}<br /><strong>{email.subject}</strong></td><td>{email.status === 'sent' ? 'Enviado' : email.status === 'failed' ? 'Error de envío' : email.status === 'sending' ? 'En proceso' : 'Pendiente'}</td><td>{email.attempts}</td><td>{['pending', 'failed'].includes(email.status) ? <form method="post" action="/api/admin/action"><input type="hidden" name="action" value="retry_email" /><input type="hidden" name="email_id" value={email.id} /><input type="hidden" name="return_to" value={returnTo} /><button type="submit" class="button button-secondary">Reintentar envío</button></form> : '—'}</td></tr>)}</tbody></table></div> : !outboxResult.error && <p class="empty-state">Todavía no hay mensajes registrados.</p>}</section>}
  {tab === 'correo' && <section class="section stack"><h2>Newsletter y preferencias</h2><p class="notice">Antes de enviar una campaña, todas las altas y bajas deben estar sincronizadas. Se priorizan las actualizaciones pendientes; las solicitudes nuevas sin confirmar no se envían al proveedor. Una baja en el proveedor de envío nunca se reactiva con este botón.</p>{newsletterResult.data?.length ? <div class="table-wrap"><table><thead><tr><th>Correo</th><th>Consentimiento</th><th>Sincronización</th><th>Última sincronización</th><th>Acción</th></tr></thead><tbody>{newsletterResult.data.map((subscriber) => <tr><td>{subscriber.email}</td><td>{subscriber.status === 'confirmed' ? 'Confirmado' : subscriber.status === 'unsubscribed' ? 'Baja registrada' : 'Nueva confirmación pendiente · baja anterior mantenida'}</td><td>{subscriber.provider_sync_status === 'synced' ? 'Actualizada' : subscriber.provider_sync_status === 'failed' ? 'Error · reintentar' : 'Pendiente'}</td><td>{subscriber.provider_synced_at ? madridDate(subscriber.provider_synced_at, true) : '—'}</td><td>{(subscriber.status !== 'pending' || subscriber.unsubscribed_at) && subscriber.provider_sync_status !== 'synced' ? <form method="post" action="/api/admin/action"><input type="hidden" name="action" value="retry_newsletter_sync" /><input type="hidden" name="subscriber_id" value={subscriber.id} /><input type="hidden" name="return_to" value={returnTo} /><button class="button button-secondary" type="submit">Sincronizar preferencias</button></form> : '—'}</td></tr>)}</tbody></table></div> : !newsletterResult.error && <p class="empty-state">Todavía no hay solicitudes de suscripción.</p>}</section>}
</LearningShell>
<style>
