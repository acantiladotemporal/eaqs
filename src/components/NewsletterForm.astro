---
interface Props { source?: string; variant?: string; ctaLabel?: string; }
const { source = 'newsletter', variant = 'default', ctaLabel = 'Quiero recibirla' } = Astro.props;
const id = 'newsletter-' + source.replace(/[^a-z0-9_-]/gi, '');
const result = Astro.url.searchParams.get('newsletter');
const responseSource = Astro.url.searchParams.get('newsletter_source');
const showResult = responseSource ? responseSource === source : source !== 'footer' || Astro.url.pathname !== '/';
const messages: Record<string,string> = { pending: 'Revisa tu correo para confirmar la suscripción.', confirmed: 'Tu suscripción está confirmada. Gracias por acompañarnos.', unsubscribed: 'Has dado de baja tu suscripción.', error: 'No hemos podido completar la suscripción. Inténtalo de nuevo más tarde.' };
---
<form class="newsletter-form" action="/api/newsletter/subscribe" method="post">
  <input type="hidden" name="source" value={source} />
  <div class="honeypot" aria-hidden="true"><label for={id + '-website'}>Dejar vacío</label><input id={id + '-website'} name="website" tabindex="-1" autocomplete="off" /></div>
  <label class:list={{ 'sr-only': variant === 'footer' }} for={id + '-email'}>Tu correo electrónico</label>
  <div class="newsletter-input-row"><input id={id + '-email'} type="email" name="email" autocomplete="email" placeholder="docente@centroeducativo.com" maxlength="254" required /><button class="button" type="submit">{ctaLabel}{variant !== 'footer' && <span aria-hidden="true">↗</span>}</button></div>
  <label class="checkbox-row" for={id + '-consent'}><input id={id + '-consent'} name="consent" type="checkbox" required /> <span>Quiero recibir por email ideas y novedades sobre las formaciones de la escuela. He leído la <a href="/privacidad" target="_blank" rel="noopener noreferrer" aria-label="Política de privacidad (se abre en otra pestaña)">política de privacidad <span aria-hidden="true">↗</span></a>. Podré darme de baja cuando quiera.</span></label>
  {showResult && result && messages[result] && <p class="form-result" role="status">{messages[result]}</p>}
</form>
