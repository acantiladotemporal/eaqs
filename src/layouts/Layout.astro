---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title,
  description = 'Formacion de elite en neuroeducacion musical para docentes de 0 a 9 anos con foco en primera infancia.',
  image = 'https://eaqs.vercel.app/og-image.jpg',
  canonical,
} = Astro.props;

const canonicalUrl = canonical ?? Astro.url?.href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Space+Grotesk:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-ink font-sans antialiased" style="background-color:#fff">
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <slot />
    <script is:inline>
      (() => {
        const doc = document.documentElement;
        doc.classList.add('js-ready');

        const main = document.querySelector('main');
        if (main && !main.id) main.id = 'main-content';

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion) doc.classList.add('no-motion');

        const revealNodes = Array.from(document.querySelectorAll('[data-reveal], .anim-reveal'));
        if (reduceMotion || !('IntersectionObserver' in window)) {
          revealNodes.forEach((node) => node.classList.add('is-visible'));
        } else {
          const observer = new IntersectionObserver(
            (entries, obs) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              });
            },
            {
              rootMargin: '0px 0px -12% 0px',
              threshold: 0.15,
            }
          );

          revealNodes.forEach((node) => observer.observe(node));
        }

        const header = document.querySelector('[data-site-header]');
        const progress = document.querySelector('[data-scroll-progress]');
        const syncHeader = () => {
          const currentY = window.scrollY || window.pageYOffset || 0;
          if (header) header.classList.toggle('is-scrolled', currentY > 14);

          const scrollable = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = scrollable > 0 ? Math.min(Math.max(currentY / scrollable, 0), 1) : 0;
          if (progress) progress.style.setProperty('--scroll-progress', String(ratio));
        };

        syncHeader();
        window.addEventListener('scroll', syncHeader, { passive: true });
        window.addEventListener('resize', syncHeader);
      })();
    </script>
  </body>
</html>
