---
import { getCollection } from 'astro:content'; import Layout from '../../layouts/Layout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout title="Música y aprendizaje en Infantil · Cuaderno de la escuela" description="Reflexiones sobre música, infancia y práctica docente de El Árbol Que Suena. Preguntas y lecturas para observar y pensar lo que ocurre en el aula." noindex={!posts.length}>
  <Header /><main id="main-content"><header class="shell page-heading"><p class="eyebrow">Música, infancia y práctica docente</p><h1>Un cuaderno<br /><em><span class="editorial-accent">para escuchar.</span></em></h1><p class="lead">Preguntas y reflexiones alrededor del aula. Un espacio que iremos construyendo con tiempo.</p></header><section class="shell page-body">
    {posts.length ? <div class="journal-list">{posts.map((post) => <article class="journal-item"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('es-ES', { month: 'long', year: 'numeric' })}</time><a href={'/blog/' + post.id}><h2>{post.data.title}</h2><p>{post.data.description}</p></a></article>)}</div> : <div class="empty-state"><h2>Las primeras páginas están por llegar.</h2><p>Puedes apuntarte a la newsletter para recibir las próximas reflexiones de la escuela.</p><a href="#newsletter" class="text-link">Recibir la newsletter <span aria-hidden="true">↓</span></a></div>}
  </section></main><Footer />
</Layout>
