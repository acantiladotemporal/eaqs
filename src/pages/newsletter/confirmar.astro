---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const token = Astro.url.searchParams.get('token') || '';
const valid = /^[\w-]{43}$/.test(token);
const error = Astro.url.searchParams.get('error');
const pending = Astro.url.searchParams.get('done') === 'pending';
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---
<Layout title="Confirmar suscripción | El Árbol Que Suena" experience="focused"><Header mode="focused" /><main id="main-content" class="shell section stack preference-page"><p class="eyebrow">Newsletter</p><h1 class="display">Un espacio<br /><em><span class="editorial-accent">para escuchar.</span></em></h1>
  {pending ? <section class="panel stack"><h2>Tu correo está confirmado.</h2><p>Hemos registrado tu consentimiento. La escuela terminará de preparar el alta antes del primer envío.</p><a class="button button-secondary" href="/">Volver a la escuela</a></section> : error === 'suppressed' ? <section class="panel stack"><h2>Respetamos tu baja.</h2><p>Tu dirección ya constaba como dada de baja en el servicio de envío y no la hemos reactivado. Si deseas volver a suscribirte, contacta con la escuela para revisar tus preferencias.</p><a class="button button-secondary" href="/contacto">Contactar con la escuela</a></section> : error === 'unavailable' ? <section class="panel stack"><h2>No hemos podido comprobar la suscripción.</h2><p>Inténtalo más tarde abriendo de nuevo el enlace que recibiste por correo. Si el problema continúa, escribe a la escuela.</p><a class="button button-secondary" href="/contacto">Contactar</a></section> : valid && !error ? <form method="post" action="/api/newsletter/confirm" class="panel stack"><p>Confirma tu suscripción para recibir nuestra newsletter. Puedes darte de baja cuando quieras.</p><input type="hidden" name="token" value={token} /><div><button class="button" type="submit">Confirmar mi suscripción ↗</button></div></form> : <section class="panel stack"><p>El enlace no es válido o ha caducado. Puedes solicitar uno nuevo desde la newsletter.</p><a class="button button-secondary" href="/#newsletter">Ir a la newsletter</a></section>}
</main><Footer mode="focused" /></Layout>
