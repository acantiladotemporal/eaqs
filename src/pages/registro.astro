---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/ui/Button.astro';
import Field from '../components/ui/Field.astro';
import { isSupabaseConfigured } from '../lib/supabase';
---

<Layout
  title="Registro | El Arbol Que Suena"
  description="Crea tu cuenta y continua al pago para reservar tu plaza en el curso de neuroeducacion musical."
>
  <Header />

  <main class="bg-white pt-36 md:pt-40 pb-20">
    <section class="section-shell">
      <div class="content-shell max-w-3xl space-y-10 md:space-y-12">
        <header class="text-center max-w-2xl mx-auto space-y-5" data-reveal>
          <p class="editorial-kicker">Reserva de plaza</p>
          <h1 class="headline-luxe section-title">
            Crea tu cuenta y continua al pago.
          </h1>
          <p class="lead-copy">
            Primer paso para entrar al aula. Plazas limitadas: maximo 20 docentes por convocatoria.
          </p>
          <p class="font-sans text-xs uppercase tracking-[0.2em] text-ink/55">
            Oferta de lanzamiento: 390 EUR . luego 490 EUR
          </p>
          {
            !isSupabaseConfigured && (
              <p class="text-sm text-red-700">
                Falta configurar Supabase en este entorno (PUBLIC_SUPABASE_URL y PUBLIC_SUPABASE_ANON_KEY).
              </p>
            )
          }
        </header>

        <section class="ui-panel p-7 md:p-10 max-w-2xl mx-auto" data-reveal style="--reveal-delay:120ms">
          <form id="register-form" class="space-y-6" novalidate>
            <Field id="name" label="Nombre completo" placeholder="Nombre Apellido" autocomplete="name" required />
            <Field id="email" type="email" label="Correo electronico" placeholder="tu@email.com" autocomplete="email" required />
            <Field
              id="password"
              type="password"
              label="Contrasena"
              placeholder="Minimo 6 caracteres"
              autocomplete="new-password"
              hint="Usa una contrasena segura para proteger tu cuenta."
              required
            />

            <p id="register-feedback" class="text-sm text-ink/60 min-h-6" aria-live="polite"></p>
            <Button id="btn-register" type="submit" variant="primary" size="lg" block>Crear cuenta y continuar al pago</Button>
          </form>

          <p class="text-center font-sans text-xs text-ink/55 mt-6">
            Ya tienes cuenta?
            <a href="/login" class="text-ink underline decoration-1 underline-offset-4 hover:text-moss">Iniciar sesion</a>
          </p>
        </section>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import { isSupabaseConfigured, supabase } from '../lib/supabase';

    const form = document.getElementById('register-form');
    const feedback = document.getElementById('register-feedback');
    const button = document.getElementById('btn-register');

    function setFeedback(message, isError = false) {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.className = isError ? 'text-sm text-red-700 min-h-6' : 'text-sm text-ink/60 min-h-6';
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!isSupabaseConfigured) {
        setFeedback('Supabase no esta configurada en este entorno.', true);
        return;
      }

      const emailInput = document.getElementById('email');
      const passwordInput = document.getElementById('password');
      const nameInput = document.getElementById('name');

      const email = (emailInput instanceof HTMLInputElement ? emailInput.value : '').trim();
      const password = passwordInput instanceof HTMLInputElement ? passwordInput.value : '';
      const name = (nameInput instanceof HTMLInputElement ? nameInput.value : '').trim();

      if (!email || !password || !name) {
        setFeedback('Completa nombre, email y contrasena.', true);
        return;
      }

      if (password.length < 6) {
        setFeedback('La contrasena debe tener al menos 6 caracteres.', true);
        return;
      }

      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
        button.textContent = 'Creando cuenta...';
      }

      setFeedback('');

      try {
        const { error } = await supabase.auth.signUp({
          email,
          password,
          options: { data: { full_name: name } },
        });

        if (error) {
          setFeedback(error.message, true);
          if (button instanceof HTMLButtonElement) {
            button.disabled = false;
            button.textContent = 'Crear cuenta y continuar al pago';
          }
          return;
        }

        window.location.assign('/pago?source=registro');
      } catch (_error) {
        setFeedback('Error de conexion. Revisa tu red e intentalo otra vez.', true);
        if (button instanceof HTMLButtonElement) {
          button.disabled = false;
          button.textContent = 'Crear cuenta y continuar al pago';
        }
      }
    });
  </script>
</Layout>
