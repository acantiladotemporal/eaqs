---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Gracias | El Arbol Que Suena" description="Confirmacion de pago y acceso al aula privada.">
  <Header />

  <main class="bg-white min-h-screen pt-24 md:pt-28 pb-16 md:pb-20">
    <section class="section-shell pt-8 md:pt-10 pb-14 md:pb-16">
      <div class="content-shell max-w-3xl">
        <article class="ui-panel p-8 md:p-12 text-center space-y-6" data-reveal>
          <p class="editorial-kicker">Confirmacion de compra</p>
          <h1 id="thanks-title" class="headline-luxe section-title">Validando tu pago...</h1>
          <p id="thanks-copy" class="lead-copy max-w-2xl mx-auto">
            Estamos comprobando tu sesion de checkout para activar tu acceso privado.
          </p>
          <p id="thanks-feedback" class="text-sm text-ink/60 min-h-6" aria-live="polite"></p>

          <div id="thanks-actions" class="pt-2 flex flex-wrap items-center justify-center gap-3">
            <a href="/registro" class="btn btn-md btn-secondary">Volver a reservar</a>
          </div>
        </article>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const titleNode = document.getElementById('thanks-title');
    const copyNode = document.getElementById('thanks-copy');
    const feedbackNode = document.getElementById('thanks-feedback');
    const actionsNode = document.getElementById('thanks-actions');

    function setView({ title, copy, feedback = '', actions = [] }) {
      if (titleNode) titleNode.textContent = title;
      if (copyNode) copyNode.textContent = copy;
      if (feedbackNode) {
        feedbackNode.textContent = feedback;
        feedbackNode.className = feedback.includes('Error') ? 'text-sm text-red-700 min-h-6' : 'text-sm text-ink/60 min-h-6';
      }

      if (!actionsNode) return;
      actionsNode.innerHTML = '';

      actions.forEach((action) => {
        const link = document.createElement('a');
        link.href = action.href;
        link.className = action.variant === 'primary' ? 'btn btn-md btn-primary' : 'btn btn-md btn-secondary';
        link.textContent = action.label;
        actionsNode.appendChild(link);
      });
    }

    async function loadStatus() {
      const params = new URLSearchParams(window.location.search);
      const sessionId = params.get('session_id');

      if (!sessionId) {
        setView({
          title: 'No encontramos una confirmacion de pago.',
          copy: 'Para activar acceso privado necesitas volver al checkout y completar el pago.',
          actions: [
            { href: '/registro', label: 'Ir a reservar plaza', variant: 'primary' },
            { href: '/contacto', label: 'Hablar con soporte', variant: 'secondary' },
          ],
        });
        return;
      }

      try {
        const response = await fetch(`/api/checkout/status?session_id=${encodeURIComponent(sessionId)}`);
        const payload = await response.json().catch(() => ({}));

        if (!response.ok || payload?.ok === false) {
          setView({
            title: 'No pudimos validar el pago.',
            copy: 'Si el cargo se realizo, soporte revisara tu caso de inmediato.',
            feedback: `Error: ${payload?.message || 'estado de pago no disponible.'}`,
            actions: [
              { href: '/contacto', label: 'Contactar soporte', variant: 'primary' },
              { href: '/registro', label: 'Volver al checkout', variant: 'secondary' },
            ],
          });
          return;
        }

        if (!payload.paid) {
          setView({
            title: 'El pago aun no esta completado.',
            copy: 'Vuelve al checkout para finalizar tu reserva.',
            actions: [
              { href: '/registro', label: 'Volver a reservar', variant: 'primary' },
              { href: '/contacto', label: 'Contactar soporte', variant: 'secondary' },
            ],
          });
          return;
        }

        setView({
          title: 'Tu plaza esta confirmada.',
          copy: 'Te hemos enviado la confirmacion de compra y el acceso al aula privada. Tu recorrido ya esta preparado.',
          feedback: 'Todo listo: puedes entrar ahora y ver los modulos segun calendario de la cohorte.',
          actions: [
            { href: '/login?next=/dashboard', label: 'Entrar a mi perfil', variant: 'primary' },
            { href: '/dashboard', label: 'Ir al dashboard', variant: 'secondary' },
          ],
        });
      } catch (_error) {
        setView({
          title: 'Error de conexion al validar el pago.',
          copy: 'Reintenta en unos segundos o contacta con soporte.',
          feedback: 'Error: no se pudo conectar con el servicio de confirmacion.',
          actions: [
            { href: '/contacto', label: 'Contactar soporte', variant: 'primary' },
            { href: '/registro', label: 'Volver al checkout', variant: 'secondary' },
          ],
        });
      }
    }

    loadStatus();
  </script>
</Layout>
