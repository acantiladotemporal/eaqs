---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Quiz modulo 1 | El Arbol Que Suena" description="Redireccion al quiz del modulo 1.">
  <Header mode="learning" />
  <main class="bg-white min-h-screen pt-20 md:pt-24 pb-16 md:pb-20">
    <section class="section-shell pt-6 md:pt-8 pb-14 md:pb-16">
      <div class="content-shell max-w-3xl ui-panel p-8 md:p-10 text-center space-y-5" data-reveal>
        <p class="editorial-kicker">Redireccion</p>
        <h1 class="headline-luxe section-title">Abriendo quiz del modulo 1...</h1>
        <a href="/examen/1" class="btn btn-lg btn-primary">Ir ahora</a>
      </div>
    </section>
  </main>

  <script>
    window.location.replace('/examen/1');
  </script>
</Layout>

