---
import LearningShell from '../../components/LearningShell.astro';
import ContinueLearning from '../../components/ContinueLearning.astro';
import { COURSE_MODULES, COURSE_NAME } from '../../lib/course-data';
if (!import.meta.env.DEV) return new Response('No encontrado.', { status: 404 });
const screens: Record<string, [string, string, string]> = {
  aula: ['Un tiempo para aprender.', 'Tu itinerario', 'Avanza con calma, lleva cada propuesta al aula y comparte lo que descubres.'],
  modulo: ['Arquitectura cerebral', 'Clase y materiales', 'Bases biológicas del procesamiento sonoro y la atención infantil.'],
  cuestionario: ['Una pausa para observar.', 'Cuestionario de participación', 'Completar las preguntas registra la participación. El recorrido no exige una nota mínima.'],
  comunidad: ['Conversaciones que acompañan.', 'Comunidad de tu cohorte', 'Un lugar para preguntar, escuchar y compartir lo que sucede en tu práctica docente.'],
  tutorias: ['Un encuentro para seguir pensando.', 'Tutorías y acompañamiento', 'Los encuentros de tu cohorte, con horarios de referencia de Madrid.'],
  'trabajo-final': ['Lo aprendido, en tu propia práctica.', 'Trabajo final', 'Una propuesta para integrar el recorrido y compartir tu mirada con la docente.'],
  certificado: ['Un recorrido que deja huella.', 'Certificado propio de la escuela', 'La emisión real requiere completar los cuestionarios y aprobar el trabajo final.'],
  solicitud: ['Tu primer paso en la escuela.', 'Seguimiento de admisión', 'Recorre los estados de una solicitud de ejemplo. La aceptación no confirma una matrícula.'],
  administracion: ['Un espacio para acompañar.', 'Panel de la escuela', 'Solicitudes, alumnado, contenidos, trabajos, comunidad, tutorías y correo.'],
};
const screen = Astro.params.section || '';
if (!screens[screen]) return new Response('No encontrado.', { status: 404 });
const module = COURSE_MODULES.find((item) => item.id === Astro.url.searchParams.get('modulo')) || COURSE_MODULES[0];
const [screenTitle, eyebrow, description] = screens[screen];
const title = screen === 'modulo' ? module.title : screenTitle;
const admin = screen === 'administracion';
const tab = Astro.url.searchParams.get('tab') || 'resumen';
const state = Astro.url.searchParams.get('estado') || 'pendiente';
const stateText: Record<string,string> = { pendiente: 'Solicitud enviada · en revisión', aceptada: 'Solicitud aceptada · pendiente de pago', espera: 'En lista de espera' };
---
<LearningShell title={title} eyebrow={eyebrow} description={description} admin={admin} preview>
  <p class="notice demo-result" id="demo-result" role="status" hidden></p>

  {screen === 'aula' && <>
    <ContinueLearning href="/vista-previa/modulo?modulo=1" title={COURSE_MODULES[0].title} position="1" />
    <section class="panel cohort-summary"><div><p class="eyebrow">Tu grupo · Ejemplo</p><h2>Primera edición</h2><p class="muted">Calendario por confirmar · Horario de referencia: Madrid</p></div><div><p class="progress-number">0<span>/10</span></p><p class="muted">cuestionarios completados</p><progress value="0" max="10" aria-label="Progreso de ejemplo">0 de 10</progress></div></section>
    <section class="review-block"><h2>Tu itinerario</h2><p class="muted">Todas las pantallas se pueden abrir durante esta revisión. En el aula real, los módulos se abren por calendario y participación.</p><ol class="learning-modules">{COURSE_MODULES.map((item)=><li><span class="module-number">{item.numero}</span><div><p class="status">Pantalla de ejemplo</p><h3><a href={`/vista-previa/modulo?modulo=${item.id}`}>{item.title}</a></h3><p>{item.description}</p></div><a class="text-link" href={`/vista-previa/modulo?modulo=${item.id}`}>Entrar ↗</a></li>)}</ol></section>
    <section class="grid-2 review-block"><a class="panel" href="/vista-previa/comunidad"><p class="eyebrow">Aprender en compañía</p><h2>La comunidad de tu cohorte ↗</h2><p>Preguntas y conversaciones entre encuentros.</p></a><a class="panel" href="/vista-previa/trabajo-final"><p class="eyebrow">Una mirada a tu práctica</p><h2>Tu trabajo final ↗</h2><p>Integración del recorrido y revisión docente.</p></a></section>
  </>}

  {screen === 'modulo' && <><a class="back-link" href="/vista-previa/aula">← Volver Al Itinerario</a><div class="lesson-layout"><div class="stack"><figure class="lesson-placeholder"><p class="eyebrow">Módulo {module.numero} · Clase grabada</p><p class="video-title">El comienzo de<br />una nueva escucha.</p><figcaption>El vídeo definitivo todavía no está cargado. Este espacio muestra la presentación de la clase.</figcaption></figure><article class="lesson-copy"><p class="eyebrow">Contenido ilustrativo</p><h2>Una pausa para observar.</h2><p>Este espacio reunirá la clase, sus ideas principales y los materiales del módulo. Cada lección invita a mirar la práctica docente con tiempo, curiosidad y atención.</p><p>{module.overview}</p></article></div><aside class="panel stack"><p class="eyebrow">En este módulo</p><h2>Tu recorrido</h2><ol><li>Clase grabada</li><li>Lectura y materiales</li><li>Cuestionario de participación</li><li>Conversación en comunidad</li></ol><p class="muted">Los materiales definitivos se publicarán aquí.</p><a class="button" href={`/vista-previa/cuestionario?modulo=${module.id}`}>Abrir cuestionario ↗</a><a class="text-link" href="/vista-previa/comunidad">Conversar con el grupo ↗</a></aside></div><div class="actions review-block">{Number(module.id)>1 && <a class="text-link" href={`/vista-previa/modulo?modulo=${Number(module.id)-1}`}>← Módulo Anterior</a>}{Number(module.id)<10 && <a class="text-link" href={`/vista-previa/modulo?modulo=${Number(module.id)+1}`}>Módulo Siguiente →</a>}</div></>}

  {screen === 'cuestionario' && <><a class="back-link" href={`/vista-previa/modulo?modulo=${module.id}`}>← Volver al módulo {module.numero}</a><section class="stack demo-fields" data-demo-fields><fieldset class="panel"><legend>Pregunta de ejemplo · {module.title}</legend><p class="question-title">¿Qué te gustaría observar en tu aula a partir de esta lección?</p><div class="field"><label for="demo-reflection">Tu reflexión de prueba</label><textarea id="demo-reflection" rows="5" required minlength="10" maxlength="3000"></textarea></div></fieldset><fieldset class="panel"><legend>Tu práctica docente</legend><p class="question-title">¿Desde dónde te gustaría empezar?</p>{['La escucha del grupo','La voz y el movimiento','El diseño de una propuesta'].map((option)=><label class="answer-option"><input type="radio" name="demo-option" value={option} required /><span>{option}</span></label>)}</fieldset><div><button class="button" type="button" data-demo-action="feedback" data-message="Participación de ejemplo completada. En esta demostración el resultado se reinicia al recargar; no se ha guardado progreso en el aula real.">Probar el registro de participación</button></div></section></>}

  {screen === 'comunidad' && <>
    <p class="notice">Comparte situaciones de aula sin nombres, imágenes ni datos que permitan identificar a niños y niñas.</p>
    <details class="panel review-block"><summary>Abrir una conversación ＋</summary><section class="stack demo-fields review-block" data-demo-fields><div class="field"><label for="demo-topic-title">Título de prueba</label><input id="demo-topic-title" minlength="5" maxlength="160" required /></div><div class="field"><label for="demo-topic-body">¿Qué quieres compartir?</label><textarea id="demo-topic-body" rows="4" minlength="10" maxlength="5000" required></textarea></div><div><button class="button" type="button" data-demo-action="topic">Publicar en esta demostración</button></div></section></details>
    <section class="stack review-block" id="demo-topics" aria-label="Conversaciones de ejemplo"><article class="panel stack"><p class="eyebrow">Conversación de ejemplo</p><h2>Una pausa para escuchar al grupo.</h2><p>¿Qué observamos cuando dejamos un momento de silencio antes de empezar una propuesta musical?</p><div id="demo-replies" class="stack"></div><details><summary>Responder a esta conversación</summary><section class="stack demo-fields review-block" data-demo-fields><div class="field"><label for="demo-reply">Tu respuesta de prueba</label><textarea id="demo-reply" minlength="3" maxlength="3000" required rows="3"></textarea></div><div><button class="button button-secondary" type="button" data-demo-action="reply">Añadir respuesta de ejemplo</button></div></section></details></article></section>
  </>}

  {screen === 'tutorias' && <><p class="notice">Consulta la diferencia horaria con tu país antes de cada encuentro.</p><section class="panel stack review-block"><p class="eyebrow">Presentación de un encuentro · Ejemplo</p><h2>Tutoría de acompañamiento de la cohorte</h2><p>Un espacio para compartir preguntas sobre las clases y revisar propuestas de aula.</p><p class="muted">Fecha, horario y enlace por confirmar.</p><button class="button button-secondary" type="button" disabled>Enlace disponible al programar el encuentro</button></section><section class="empty-state review-block"><h2>El calendario se está preparando.</h2><p>Los encuentros reales aparecerán cuando la escuela confirme las fechas de la edición.</p></section></>}

  {screen === 'trabajo-final' && <><article class="panel stack"><p class="eyebrow">Propuesta ilustrativa</p><h2>Una propuesta conectada con tu contexto.</h2><p>Describe una experiencia musical para tu aula, qué te gustaría observar y cómo revisarías la propuesta después de llevarla a la práctica. La docente publicará las instrucciones definitivas.</p></article><section class="panel stack review-block demo-fields" data-demo-fields><h2>Preparar tu entrega</h2><div class="field"><label for="demo-work">Tu reflexión de prueba</label><textarea id="demo-work" rows="8" required minlength="30" maxlength="20000"></textarea></div><div class="field"><label for="demo-file">Documento PDF de prueba (opcional)</label><input id="demo-file" type="file" accept="application/pdf" /><small>Hasta 10 MB. La demostración solo comprueba la selección; el archivo permanece en tu dispositivo.</small></div><div><button class="button" type="button" data-demo-action="work">Probar la preparación de entrega</button></div></section><details class="panel review-block"><summary>Ver el aspecto de una devolución docente</summary><div class="stack review-block"><p class="eyebrow">Devolución de ejemplo · Revisión solicitada</p><h3>Volver a mirar tu propuesta.</h3><p>Amplía qué observarías durante la experiencia y cómo utilizarías esas observaciones para ajustarla.</p><a class="text-link" href="/vista-previa/certificado">Ver la muestra del certificado ↗</a></div></details></>}

  {screen === 'certificado' && <><p class="notice">Esta muestra permite revisar el formato. El certificado real se emitirá tras cumplir los requisitos del curso.</p><article class="certificate review-block"><p class="sample-label">MUESTRA · SIN VALIDEZ</p><img src="/images/brand-logo.png" width="180" height="180" alt="El Árbol Que Suena" /><p class="eyebrow">Escuela Internacional de Neuroeducación Musical</p><h2>Certificado de finalización</h2><p>El Árbol Que Suena hace constar que</p><p class="student-name">Nombre y apellidos</p><p>ha completado el itinerario de diez módulos y el trabajo final de</p><h3>{COURSE_NAME}</h3><p>Primera edición · Fecha de emisión</p><p class="muted">Certificado propio de la escuela · Documento de ejemplo</p></article><div class="actions review-block"><button class="button" type="button" data-demo-action="print">Imprimir esta muestra</button></div></>}

  {screen === 'solicitud' && <><nav class="app-nav" aria-label="Estados de admisión">{Object.entries(stateText).map(([value,label])=><a href={`/vista-previa/solicitud?estado=${value}`} aria-current={state===value?'page':undefined}>{label}</a>)}</nav><section class="panel stack"><p class="eyebrow">Solicitud de ejemplo</p><h2>{stateText[state] || stateText.pendiente}</h2><p>Formación: {COURSE_NAME}</p><p>{state==='aceptada'?'La escuela ha aceptado la solicitud. La matrícula continúa pendiente de pago; la aceptación todavía no concede acceso al aula.':state==='espera'?'La solicitud está en lista de espera. La escuela comunicará si hay una plaza disponible.':'La escuela revisará la solicitud y comunicará su respuesta por correo.'}</p><p class="muted">Las opciones de transferencia y tarjeta se incorporarán en la fase final de pagos.</p></section></>}

  {admin && <>
    {tab==='resumen' && <><section class="admin-metrics">{[['Solicitudes de ejemplo','1'],['Matrículas activas','0'],['Límite de plazas','20']].map(([label,value])=><article class="panel"><p class="eyebrow">{label}</p><p class="metric">{value}</p></article>)}</section><section class="panel stack review-block"><h2>Primera edición</h2><p>Fechas por confirmar · Diez módulos preparados.</p><h3>Alumnado</h3><p class="muted">Las matrículas confirmadas aparecerán aquí después de verificar el ingreso. Aceptar una solicitud no añade una matrícula activa.</p><a class="text-link" href="/vista-previa/administracion?tab=solicitudes">Revisar la solicitud de ejemplo ↗</a></section></>}
    {tab==='solicitudes' && <article class="panel stack"><p class="eyebrow">Solicitud de ejemplo · Sin datos reales</p><h2>Docente de ejemplo</h2><p>España · Docente de infantil · Etapa 3–6 años</p><details><summary>Leer la motivación</summary><p class="review-block">Quiero explorar el lugar de la música en mis propuestas y pensar cómo observar la participación del grupo.</p></details><p class="status" id="demo-admission-status">En revisión</p><div class="actions"><button class="button" type="button" data-demo-action="accept">Probar aceptación</button><button class="button button-secondary" type="button" data-demo-action="waitlist">Probar lista de espera</button></div><p class="muted">La aceptación deja la matrícula pendiente de pago.</p><a class="text-link" href="/vista-previa/solicitud?estado=aceptada">Ver la pantalla del solicitante ↗</a></article>}
    {tab==='contenidos' && <section class="stack"><h2>Itinerario y materiales</h2>{COURSE_MODULES.map((item)=><details class="panel"><summary>Módulo {item.numero} · {item.title}</summary><section class="stack review-block demo-fields" data-demo-fields><div class="field"><label for={`title-${item.id}`}>Título</label><input id={`title-${item.id}`} value={item.title} required /></div><div class="field"><label for={`summary-${item.id}`}>Resumen</label><textarea id={`summary-${item.id}`} rows="3">{item.description}</textarea></div><p class="muted">Apertura por calendario · Vídeos, documentos y preguntas se gestionarán en este módulo.</p><label class="checkbox-row"><input type="checkbox" /> Publicado (ejemplo)</label><div><button class="button button-secondary" type="button" data-demo-action="feedback" data-message="Has probado la edición de un módulo. Los contenidos reales mantienen su estado sin publicar.">Probar edición del módulo</button></div><a class="text-link" href={`/vista-previa/modulo?modulo=${item.id}`}>Ver la pantalla del alumnado ↗</a></section></details>)}</section>}
    {tab==='trabajos' && <section class="panel stack demo-fields" data-demo-fields><p class="eyebrow">Entrega de ejemplo</p><h2>Una propuesta para el aula</h2><p>El contenido del trabajo y su archivo privado se consultarían aquí.</p><div class="field"><label for="demo-review">Estado de revisión</label><select id="demo-review"><option>Pendiente de revisión</option><option>Solicitar revisión</option><option>Aprobado</option></select></div><div class="field"><label for="demo-feedback">Devolución docente de ejemplo</label><textarea id="demo-feedback" rows="4"></textarea></div><div><button class="button" type="button" data-demo-action="feedback" data-message="Has probado la revisión docente. El certificado real exige también completar los diez módulos y tener la matrícula activa.">Probar revisión</button></div><a class="text-link" href="/vista-previa/certificado">Ver la muestra de certificado ↗</a></section>}
    {tab==='comunidad' && <article class="panel stack"><p class="eyebrow">Moderación · Conversación de ejemplo</p><h2>Una pausa para escuchar al grupo.</h2><p id="demo-moderated-topic">Este es el contenido ilustrativo de una conversación de la cohorte.</p><div><button class="button button-secondary" type="button" data-demo-action="moderate">Ocultar conversación de ejemplo</button></div></article>}
    {tab==='tutorias' && <section class="panel stack demo-fields" data-demo-fields><h2>Programar un encuentro</h2><div class="field"><label for="demo-meeting-title">Título del encuentro de prueba</label><input id="demo-meeting-title" required maxlength="180" /></div><div class="field"><label for="demo-meeting-date">Fecha y hora de ejemplo</label><input id="demo-meeting-date" type="datetime-local" required /></div><div><button class="button" type="button" data-demo-action="feedback" data-message="Has probado la preparación de una tutoría. El calendario real sigue pendiente de confirmar.">Probar programación</button></div></section>}
    {tab==='correo' && <section class="stack"><h2>Mensajes de la escuela</h2><div class="table-wrap"><table><thead><tr><th>Tipo</th><th>Asunto de ejemplo</th><th>Estado</th></tr></thead><tbody><tr><td>Admisión</td><td>Hemos recibido tu solicitud</td><td>Pendiente · Ejemplo</td></tr><tr><td>Acceso</td><td>Tu enlace privado al aula</td><td>Pendiente · Ejemplo</td></tr></tbody></table></div><p class="notice">El envío real espera la configuración de correo. Esta pantalla no envía mensajes.</p><article class="panel"><h3>Newsletter y preferencias</h3><p>Las suscripciones confirmadas, las bajas y el estado de sincronización se gestionarán aquí.</p></article></section>}
  </>}
  <noscript><p class="notice review-block">Las páginas y los enlaces se pueden recorrer sin JavaScript. Las interacciones de esta demostración necesitan JavaScript.</p></noscript>
</LearningShell>

<script>
  const result = document.getElementById('demo-result');
  function notify(message: string) { if(result){result.textContent=message;result.hidden=false;result.scrollIntoView({block:'center',behavior:'auto'});} }
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-demo-action]')) {
    button.addEventListener('click',()=>{
      const fields=button.closest('[data-demo-fields]');
      if(fields) for(const field of fields.querySelectorAll<HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement>('input,textarea,select')) if(!field.reportValidity()) return;
      const action=button.dataset.demoAction;
      if(action==='topic') {
        const title=document.querySelector<HTMLInputElement>('#demo-topic-title')!.value;
        const body=document.querySelector<HTMLTextAreaElement>('#demo-topic-body')!.value;
        const article=document.createElement('article');article.className='panel stack';
        const label=document.createElement('p');label.className='eyebrow';label.textContent='Tu conversación de ejemplo';
        const heading=document.createElement('h2');heading.textContent=title;
        const paragraph=document.createElement('p');paragraph.textContent=body;
        article.append(label,heading,paragraph);document.getElementById('demo-topics')?.prepend(article);
        notify('Conversación añadida solo a esta demostración. Desaparecerá al recargar la página.');
      } else if(action==='reply') {
        const paragraph=document.createElement('p');paragraph.className='demo-reply';paragraph.textContent=document.querySelector<HTMLTextAreaElement>('#demo-reply')!.value;
        document.getElementById('demo-replies')?.append(paragraph);notify('Respuesta de ejemplo añadida a esta página.');
      } else if(action==='work') {
        const file=document.querySelector<HTMLInputElement>('#demo-file')?.files?.[0];
        if(file && (!file.name.toLowerCase().endsWith('.pdf') || file.size>10*1024*1024)){notify('Selecciona un PDF de hasta 10 MB para esta prueba.');return;}
        notify('Preparación de entrega comprobada. El texto y el archivo no se han enviado ni guardado en el aula real.');
      } else if(action==='accept'||action==='waitlist') {
        const status=document.getElementById('demo-admission-status');if(status)status.textContent=action==='accept'?'Aceptada · Pendiente de pago':'En lista de espera';
        notify(action==='accept'?'La solicitud de ejemplo se muestra como aceptada. No se activa una matrícula ni acceso real al curso.':'La solicitud de ejemplo se muestra en lista de espera.');
      } else if(action==='moderate') {
        const topic=document.getElementById('demo-moderated-topic');if(topic){topic.hidden=!topic.hidden;button.textContent=topic.hidden?'Volver a mostrar la conversación de ejemplo':'Ocultar conversación de ejemplo';}
      } else if(action==='print') window.print();
      else notify(button.dataset.message || 'Interacción de ejemplo completada en esta página.');
    });
  }
</script>
<style>
.review-block{margin-top:2rem}.demo-result[hidden]{display:none}.demo-result{margin-bottom:2rem}.demo-fields{max-width:55rem}fieldset{min-width:0}legend{padding:0 .5rem}.question-title{font-size:1.15rem;margin-bottom:1rem}.answer-option{display:flex;gap:.8rem;align-items:start;padding:.8rem .3rem;border-bottom:1px solid var(--line)}.answer-option input{margin-top:.35rem;accent-color:var(--ink)}.cohort-summary{display:flex;justify-content:space-between;align-items:center;gap:2rem}.progress-number{font:400 3rem/1 var(--serif)}.progress-number span{font-size:1.2rem}progress{accent-color:var(--ochre);height:.5rem;width:100%}.learning-modules{list-style:none;padding:0}.learning-modules li{display:grid;grid-template-columns:3rem 1fr auto;gap:1.5rem;align-items:center;border-bottom:1px solid var(--line);padding:1.8rem 0}.learning-modules h3{font-size:1.65rem;margin:.5rem 0}.learning-modules p{color:var(--muted)}.module-number{align-self:start;color:var(--ink)}.lesson-layout{display:grid;grid-template-columns:minmax(0,1fr) 15rem;gap:2rem;align-items:start}.lesson-placeholder{background:var(--accent-tint);border:1px solid var(--line);min-height:25rem;padding:3rem;text-align:center;display:flex;flex-direction:column;justify-content:center;align-items:center}.video-title{font:400 clamp(2rem,4vw,3.5rem)/1.15 var(--serif);margin:1rem 0 2rem}.lesson-placeholder figcaption{font-size:.9rem;color:var(--muted);max-width:25rem}.lesson-copy h2{font-size:2.5rem;margin:1rem 0}.lesson-copy>p:not(.eyebrow){color:var(--muted)}.demo-reply{padding:1rem;border-left:2px solid var(--ochre);white-space:pre-wrap;overflow-wrap:anywhere}.admin-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.metric{font:400 3rem/1 var(--serif);margin-top:1rem}summary{cursor:pointer;font-weight:500}.certificate{border:1px solid #b5aa91;outline:1px solid #e2d7c8;outline-offset:-.75rem;padding:3rem;text-align:center;background:#fffdf8;max-width:60rem;margin-inline:auto}.certificate img{width:180px;height:140px;object-fit:contain;margin:1rem auto}.certificate h2{font-size:2.6rem;margin:1rem 0}.certificate h3{font-size:1.7rem;margin:1.5rem 0}.student-name{font:400 2.6rem/1.2 var(--serif);color:var(--ink);margin:1rem 0}.sample-label{font-size:.75rem;letter-spacing:.2em;color:var(--rust)}@media(max-width:1200px){.lesson-layout{grid-template-columns:1fr}.lesson-placeholder{min-height:20rem;padding:2rem}}@media(max-width:600px){.cohort-summary{flex-direction:column;align-items:start}.learning-modules li{grid-template-columns:2rem 1fr;gap:1rem}.learning-modules li>.text-link{grid-column:2}.admin-metrics{grid-template-columns:1fr}.certificate{padding:2rem 1.3rem}.certificate h2,.student-name{font-size:2rem}}@media print{:global(.app-toolbar),:global(.page-heading),:global(.review-notice),.demo-result,.actions{display:none!important}.certificate{break-inside:avoid;margin:0}.sample-label{font-weight:bold}}
</style>
