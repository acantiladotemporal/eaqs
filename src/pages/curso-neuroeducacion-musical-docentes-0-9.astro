---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/ui/Button.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import {
  COURSE_LAUNCH_PRICE_EUR,
  COURSE_MODULES,
  COURSE_SEAT_LIMIT,
  COURSE_STANDARD_PRICE_EUR,
} from '../lib/course-data';
---

<Layout
  title="Curso Neuroeducacion Musical para Docentes 0-9 | El Arbol Que Suena"
  description="Primera cohorte internacional de neuroeducacion musical para docentes de 0 a 9 anos."
>
  <Header />

  <main class="bg-white text-ink pt-24 md:pt-28 pb-16 md:pb-20">
    <section class="section-shell pt-10 md:pt-12 pb-12 md:pb-14">
      <div class="content-shell max-w-5xl space-y-8 md:space-y-9">
        <header class="space-y-5 text-center" data-reveal>
          <p class="editorial-kicker">Convocatoria inaugural 2026</p>
          <h1 class="headline-luxe section-title md:!text-[3.2rem]">Curso internacional de neuroeducacion musical para docentes 0-9</h1>
          <p class="lead-copy max-w-3xl mx-auto">
            Formacion avanzada para acompanar desarrollo cognitivo, motor, emocional y vincular con foco especial en 0 a 6 anos.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-3">
            <Button href="/registro?source=curso_0_9_hero" size="lg" variant="primary">Reservar mi plaza</Button>
            <Button href="/#curso" size="lg" variant="secondary">Ver programa en Home</Button>
          </div>
        </header>

        <section class="ui-panel p-7 md:p-10 space-y-6" data-reveal style="--reveal-delay:100ms">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <h2 class="font-display text-4xl md:text-5xl text-note">Itinerario completo</h2>
            <p class="text-sm text-ink/65">{COURSE_MODULES.length} modulos . Cohorte limitada a {COURSE_SEAT_LIMIT} plazas</p>
          </div>

          <div class="module-list">
            {COURSE_MODULES.map((module, index) => (
              <article class="module-row" data-reveal style={`--reveal-delay:${index * 55}ms`}>
                <span class="module-index">{module.numero}</span>
                <h3>{module.title}</h3>
                <p>{module.description}</p>
              </article>
            ))}
          </div>

          <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-clay/60">
            <p class="text-sm text-ink/66">Precio actual: {COURSE_LAUNCH_PRICE_EUR} EUR . Luego {COURSE_STANDARD_PRICE_EUR} EUR</p>
            <Button href="/registro?source=curso_0_9_cta" size="md" variant="primary">Acceder al checkout</Button>
          </div>
        </section>
      </div>
    </section>

    <section class="section-shell section-tone-ivory">
      <div class="content-shell max-w-4xl">
        <div class="newsletter-band newsletter-band-stacked space-y-7" data-reveal>
          <div class="space-y-4 max-w-none">
            <p class="editorial-kicker mb-3">Newsletter semanal</p>
            <h2 class="headline-luxe text-4xl md:text-5xl">Prefieres empezar por contenido semanal?</h2>
            <p class="lead-copy">
              Te enviaremos una secuencia de bienvenida con claves de neuroeducacion musical y te avisaremos antes de cada hito de cohorte.
            </p>
          </div>
          <div>
            <NewsletterForm source="curso_newsletter" variant="inline" ctaLabel="Recibir la secuencia" />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
