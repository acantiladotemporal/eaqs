---
import LearningShell from '../components/LearningShell.astro';
import ContinueLearning from '../components/ContinueLearning.astro';
import { INITIAL_COHORT_ID, madridDate, formNotice } from '../components/learning';
const { db, user, enrollment } = Astro.locals;
if (!db || !user) return Astro.redirect('/login');
const cohortId = enrollment?.cohort_id || INITIAL_COHORT_ID;
const [moduleResult, participationResult, cohortResult] = await Promise.all([
  db.from('modules').select('id,position,title,summary,unlock_at').eq('cohort_id', cohortId).order('position'),
  db.from('quiz_participations').select('module_id').eq('user_id', user.id),
  db.from('cohorts').select('title,start_at').eq('id', cohortId).maybeSingle(),
]);
const failed = moduleResult.error || participationResult.error || cohortResult.error;
const modules = moduleResult.data || [];
const completed = new Set((participationResult.data || []).map((item) => item.module_id));
const nextModule = modules.find(module => !completed.has(module.id)) || modules.at(-1);
const notice = formNotice(Astro.url);
const fullName = typeof user.user_metadata?.full_name === 'string' ? user.user_metadata.full_name.split(' ')[0] : 'docente';
---
<LearningShell title={`Un tiempo para aprender, ${fullName}.`} description="Avanza con calma, lleva cada propuesta al aula y comparte lo que descubres.">
  {notice && <p class={`notice ${notice.kind}`} role="status">{notice.message}</p>}
  {failed ? <p class="notice error" role="alert">No hemos podido cargar tu itinerario. Vuelve a intentarlo en unos minutos.</p> : <>
    {nextModule && <ContinueLearning href={`/modulos/${nextModule.id}`} title={nextModule.title} position={nextModule.position} review={completed.has(nextModule.id)} />}
    <section class="panel cohort-summary">
      <div><p class="eyebrow">Tu grupo</p><h2>{cohortResult.data?.title || 'Primera edición'}</h2><p class="muted">Inicio: {madridDate(cohortResult.data?.start_at)} · Horario de referencia: Madrid</p></div>
      <div><p class="progress-number">{completed.size}<span>/10</span></p><p class="muted">cuestionarios completados</p><progress value={completed.size} max="10" aria-label="Cuestionarios completados">{completed.size} de 10</progress></div>
    </section>
    <section class="section stack" aria-labelledby="itinerary-heading">
      <div class="section-heading"><p class="eyebrow">Del conocimiento a la práctica</p><h2 id="itinerary-heading">Tu itinerario</h2></div>
      {modules.length ? <ol class="learning-modules">{modules.map((module) => <li>
        <span class="module-number">{String(module.position).padStart(2, '0')}</span>
        <div><p class="status">{completed.has(module.id) ? 'Participación completada' : 'Disponible'}</p><h3><a href={`/modulos/${module.id}`}>{module.title}</a></h3><p>{module.summary}</p></div>
        <a class="module-open" href={`/modulos/${module.id}`} aria-label={`Abrir ${module.title}`}>Entrar <span aria-hidden="true">↗</span></a>
      </li>)}</ol> : <div class="empty-state"><h3>El itinerario se está preparando.</h3><p>Los módulos aparecerán aquí cuando la escuela los publique y llegue su fecha de apertura. No necesitas realizar ninguna acción.</p></div>}
      {modules.length < 10 && <p class="muted">Los siguientes módulos se irán abriendo por calendario y participación en los cuestionarios anteriores.</p>}
    </section>
    <section class="grid-2 section">
      <a class="panel support-link" href="/foro"><p class="eyebrow">Aprender en compañía</p><h2>La comunidad de tu cohorte <span aria-hidden="true">↗</span></h2><p>Preguntas, experiencias y conversaciones que continúan entre encuentros.</p></a>
      <a class="panel support-link" href="/trabajo-final"><p class="eyebrow">Una mirada a tu práctica</p><h2>Tu trabajo final <span aria-hidden="true">↗</span></h2><p>Un espacio para integrar lo aprendido, con revisión de la docente.</p></a>
    </section>
  </>}
</LearningShell>
<style>
.cohort-summary{display:flex;justify-content:space-between;gap:2rem;align-items:center}.progress-number{font-size:3rem;line-height:1.1;margin:0}.progress-number span{font-size:1.2rem;color:var(--muted,#716a60)}progress{accent-color:var(--ochre);width:100%;height:.5rem}.learning-modules{list-style:none;padding:0}.learning-modules li{display:grid;grid-template-columns:3rem 1fr auto;align-items:center;gap:1.5rem;border-top:1px solid var(--line,#e2d7c8);padding:1.8rem 0}.learning-modules h3{font-size:1.65rem;margin:.25rem 0}.learning-modules p{margin:.25rem 0}.module-number{align-self:start;color:var(--muted,#716a60);font-size:1.1rem}.module-open{white-space:nowrap}.support-link{color:inherit;text-decoration:none}.support-link h2{font-size:1.8rem}.support-link h2 span{float:right}@media(max-width:600px){.cohort-summary{align-items:start;flex-direction:column}.learning-modules li{grid-template-columns:2rem 1fr;gap:1rem}.module-open{grid-column:2}}
</style>
