{
  "name": "elarbolquesuena-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "npm run check && astro build",
    "build:release": "npm test && npm run test:db && npm run check && npm run build:cloudflare && npm run check:cloudflare",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "check:cloudflare": "node scripts/check-cloudflare-output.mjs",
    "deploy:cloudflare": "wrangler deploy",
    "test:worker": "node tests/worker.smoke.mjs",
    "check:release": "node scripts/check-release-files.mjs",
    "preview": "node ./dist/server/entry.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:db": "node --test tests/sql/*.test.mjs",
    "verify": "npm run test && npm run test:db && npm run build && npm run test:http",
    "astro": "astro",
    "test:http": "node tests/http.smoke.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.3",
    "@astrojs/node": "11.1.9",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "astro": "7.4.4",
    "aws4fetch": "1.0.20",
    "svix": "2.9.1",
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@electric-sql/pglite": "0.5.14",
    "@types/node": "24.19.2",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "supabase": "2.122.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.156.1"
  }
}
