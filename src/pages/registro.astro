---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { COURSE_LAUNCH_PRICE_EUR, COURSE_STANDARD_PRICE_EUR, COURSE_SEAT_LIMIT } from '../lib/course-data';
const sent = Astro.url.searchParams.get('sent') === '1';
const errorCode = Astro.url.searchParams.get('error');
const errors: Record<string,string> = { validation: 'Revisa los campos y acepta la política de privacidad para enviar tu solicitud.', unavailable: 'No hemos podido recibir tu solicitud en este momento. Inténtalo de nuevo más tarde.', closed: 'Las solicitudes para esta edición están cerradas. Puedes apuntarte a la newsletter para recibir novedades.', rate: 'Has realizado varios intentos. Espera unos minutos antes de volver a enviarla.', rate_limit: 'Has realizado varios intentos. Espera unos minutos antes de volver a enviarla.' };
---
<Layout title="Solicitar plaza · El Árbol Que Suena" experience="focused">
  <Header mode="focused" />
  <main id="main-content" class="application-page">
    <header class="shell page-heading application-heading"><p class="eyebrow">Solicitud de admisión · Docentes de 0–6 años</p><h1>Empecemos por <em><span class="editorial-accent">conocernos.</span></em></h1><p class="lead">Cuéntanos sobre tu práctica docente. La escuela revisará tu solicitud y te responderá por correo.</p><p class="application-summary"><strong>{COURSE_LAUNCH_PRICE_EUR} € · Edición enero 2027</strong> · 10 módulos · {COURSE_SEAT_LIMIT} plazas</p><p class="application-conditions">Calendario detallado por confirmar. Enviar la solicitud no implica un pago ni confirma una plaza.</p></header>
    <div class="shell page-body application-grid">
      <div class="application-main">
      {sent ? <section class="panel stack" role="status"><p class="eyebrow">Solicitud recibida</p><h2>Gracias por compartir<br />tu mirada.</h2><p>La escuela revisará tu solicitud. La respuesta llegará al correo que has indicado; revisa también la carpeta de correo no deseado.</p><p>Tu plaza todavía no está confirmada y no se ha realizado ningún cobro.</p><a class="text-link" href="/programa">Volver al programa <span aria-hidden="true">↗</span></a></section> : <>
        {errorCode && <p class="notice notice-error" role="alert">{errors[errorCode] || 'No hemos podido enviar tu solicitud. Revisa los datos e inténtalo de nuevo.'}</p>}
        {errorCode === 'closed' && <p class="notice"><a class="text-link" href="/#newsletter">Recibir Las Próximas Novedades <span aria-hidden="true">↗</span></a></p>}
        <form class="application-form" action="/api/applications" method="post">
          <div class="honeypot" aria-hidden="true"><label for="application-website">Dejar vacío</label><input id="application-website" name="website" autocomplete="off" tabindex="-1" /></div>
          <fieldset class="application-fields"><legend>Tus datos</legend>
            <div class="field"><label for="full_name">Nombre y apellidos</label><input id="full_name" name="full_name" autocomplete="name" required maxlength="120" /></div>
            <div class="field"><label for="email">Correo electrónico</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" /><small>Te escribiremos aquí para responder a tu solicitud.</small></div>
            <div class="field"><label for="country">País</label><input id="country" name="country" autocomplete="country-name" required maxlength="80" /></div>
          </fieldset>
          <fieldset class="application-fields"><legend>Tu práctica docente</legend>
          <div class="field"><label for="role">Tu ocupación</label><input id="role" name="role" placeholder="Docente de infantil, educadora…" required maxlength="120" /></div>
          <div class="field"><label for="age_range">¿Con qué edades trabajas?</label><select id="age_range" name="age_range" required><option value="">Selecciona una opción</option><option value="0-3">De 0 a 3 años</option><option value="3-6">De 3 a 6 años</option><option value="0-6">De 0 a 6 años</option><option value="other">Otro contexto o etapa formativa</option></select></div>
          <div class="field"><label for="motivation">¿Qué te gustaría explorar en esta formación?</label><textarea id="motivation" name="motivation" rows="5" required minlength="20" maxlength="2000" placeholder="Puedes contarnos sobre tus preguntas, tu aula o lo que te ha traído hasta aquí."></textarea><small>Entre 20 y 2.000 caracteres. Evita incluir datos personales de niños o niñas.</small></div>
          </fieldset>
          <div><label class="checkbox-row" for="privacy"><input id="privacy" type="checkbox" name="privacy" required /><span>He leído y acepto la <a href="/privacidad" target="_blank" rel="noopener noreferrer">política de privacidad (se abre en otra pestaña)</a> para gestionar esta solicitud.</span></label><label class="checkbox-row" for="newsletter"><input id="newsletter" type="checkbox" name="newsletter" /><span>También quiero recibir por email ideas y novedades sobre las formaciones de la escuela. Es opcional y podré darme de baja.</span></label></div>
          <button class="button" type="submit">Solicitar Plaza <span aria-hidden="true">↗</span></button>
          <p class="muted fineprint">La admisión se revisa personalmente. El envío no confirma una plaza.</p>
        </form>
      </>}
      </div>
      <aside class="application-aside"><p class="eyebrow">La formación de un vistazo</p><h2>Neuroeducación musical para la primera infancia.</h2><ul><li>Para docentes de 0–6 años, especialmente 3–6</li><li>Online y en español · España y Latinoamérica</li><li>10 módulos · Clases grabadas y tutorías</li><li>Hasta {COURSE_SEAT_LIMIT} personas por cohorte</li><li>{COURSE_LAUNCH_PRICE_EUR} € · Edición enero 2027</li><li>En mayo de 2027 sube a {COURSE_STANDARD_PRICE_EUR} €</li><li>Calendario detallado por confirmar</li></ul><p>Tras la revisión humana, si tu solicitud es aceptada, recibirás los siguientes pasos para formalizar la matrícula cuando se habilite el cobro.</p><p>¿Tienes alguna pregunta? <a class="text-link" href="/contacto">Hablemos <span aria-hidden="true">↗</span></a></p></aside>
    </div>
  </main><Footer mode="focused" />
</Layout>
