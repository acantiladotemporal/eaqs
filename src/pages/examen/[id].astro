---
import LearningShell from '../../components/LearningShell.astro';
import { formNotice } from '../../components/learning';
const { db, user } = Astro.locals;
if (!db || !user) return Astro.redirect('/login');
const { data: module, error } = await db.from('modules').select('id,position,title').eq('id', Astro.params.id || '').maybeSingle();
if (error || !module) return new Response('Este cuestionario no está disponible.', { status: 404 });
const [questionResult, participationResult] = await Promise.all([
  db.from('quiz_questions').select('id,prompt,options').eq('module_id', module.id).order('id'),
  db.from('quiz_participations').select('completed_at').eq('module_id', module.id).eq('user_id', user.id).maybeSingle(),
]);
const questions = questionResult.data || [];
const notice = formNotice(Astro.url);
---
<LearningShell eyebrow={`Cuestionario · Módulo ${String(module.position).padStart(2, '0')}`} title={module.title} description="Una pausa para pensar lo que acabas de aprender. Completar todas las preguntas registra tu participación; no hay nota mínima.">
  <a href={`/modulos/${module.id}`}>← Volver al módulo</a>
  {notice && <p class={`notice ${notice.kind}`} role="status">{notice.message}</p>}
  {questionResult.error || participationResult.error ? <p class="notice error">No hemos podido cargar el cuestionario. Inténtalo más tarde.</p> : participationResult.data ? <section class="panel section"><p class="eyebrow">Participación registrada</p><h2>Ya has completado este cuestionario.</h2><p>Puedes continuar tu itinerario cuando se abra el siguiente módulo.</p><a href="/dashboard" class="button">Volver al itinerario</a></section> : questions.length ? <form action="/api/learning/action" method="post" class="quiz-form section stack">
    <input type="hidden" name="action" value="complete_quiz" /><input type="hidden" name="module_id" value={module.id} /><input type="hidden" name="return_to" value={`/examen/${module.id}`} />
    {questions.map((question, index) => <fieldset class="panel">
      <legend><span class="eyebrow">Pregunta {index + 1}</span><span class="question-title">{question.prompt}</span></legend>
      {Array.isArray(question.options) && question.options.length ? question.options.map((option: string) => <label class="answer-option"><input type="radio" name={`q_${question.id}`} value={option} required /><span>{option}</span></label>) : <div class="field"><label for={`q_${question.id}`}>Tu reflexión</label><textarea id={`q_${question.id}`} name={`q_${question.id}`} rows={4} maxlength={3000} required></textarea></div>}
    </fieldset>)}
    <div><button type="submit" class="button">Registrar mi participación</button></div>
  </form> : <section class="empty-state section"><h2>El cuestionario se está preparando.</h2><p>La escuela lo publicará aquí cuando esté listo.</p></section>}
</LearningShell>
<style>
.quiz-form{max-width:50rem}.quiz-form fieldset{min-width:0;border:1px solid var(--line,#e2d7c8)}legend{padding:0 .5rem;max-width:100%}.question-title{display:block;font-size:1.4rem;margin-top:.5rem}.answer-option{display:flex;gap:.8rem;align-items:flex-start;padding:1rem .5rem;cursor:pointer;border-bottom:1px solid var(--line,#e2d7c8)}.answer-option input{margin-top:.35rem;accent-color:var(--ochre);flex:0 0 auto}
</style>

