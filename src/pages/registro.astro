---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/ui/Button.astro';
import Field from '../components/ui/Field.astro';
---

<Layout
  title="Registro | El Arbol Que Suena"
  description="Crea tu cuenta y continua al pago para reservar tu plaza en el curso de neuroeducacion musical."
>
  <Header />

  <main class="bg-white pt-28 md:pt-32 pb-16 md:pb-20">
    <section class="section-shell bg-white">
      <div class="content-shell grid lg:grid-cols-12 gap-8 md:gap-10 items-start">
        <aside class="lg:col-span-5 space-y-6" data-reveal>
          <p class="editorial-kicker">Reserva de plaza</p>
          <h1 class="headline-luxe section-title">
            Crea tu cuenta y
            <span class="ink-underline-subtle">continua al pago</span>.
          </h1>
          <p class="lead-copy">
            Este es el primer paso para entrar al aula. Tras registrarte, pasaras a la pantalla de pago para confirmar tu plaza.
          </p>

          <div class="ui-panel p-6 md:p-7 space-y-4 bg-white">
            <p class="font-sans text-[10px] uppercase tracking-[0.25em] text-moss font-bold">Convocatoria 2026</p>
            <ul class="space-y-3 text-sm text-ink/78">
              <li class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-ochre mt-2"></span>6 modulos de especializacion.</li>
              <li class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-ochre mt-2"></span>Certificacion oficial incluida.</li>
              <li class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-ochre mt-2"></span>Plazas limitadas: maximo 20 docentes.</li>
            </ul>
            <div class="pt-4 border-t border-clay/60">
              <p class="font-display text-4xl italic text-note">390 EUR</p>
              <p class="text-xs text-ink/60 uppercase tracking-[0.18em] mt-1">Oferta de lanzamiento . luego 490 EUR</p>
            </div>
          </div>
        </aside>

        <section class="lg:col-span-7 ui-panel p-7 md:p-10 bg-white" data-reveal style="--reveal-delay:120ms">
          <div class="max-w-xl mx-auto space-y-8">
            <div>
              <p class="editorial-kicker mb-3">Datos de acceso</p>
              <h2 class="headline-luxe text-4xl md:text-5xl">Crear cuenta</h2>
            </div>

            <form id="register-form" class="space-y-6" novalidate>
              <Field id="name" label="Nombre completo" placeholder="Nombre Apellido" autocomplete="name" required />
              <Field id="email" type="email" label="Correo electronico" placeholder="tu@email.com" autocomplete="email" required />
              <Field
                id="password"
                type="password"
                label="Contrasena"
                placeholder="Minimo 6 caracteres"
                autocomplete="new-password"
                hint="Usa una contrasena segura para proteger tu cuenta."
                required
              />

              <p id="register-feedback" class="text-sm text-ink/60 min-h-6" aria-live="polite"></p>
              <Button id="btn-register" type="submit" variant="primary" size="lg" block>Crear cuenta y continuar al pago</Button>
            </form>

            <p class="text-center font-sans text-xs text-ink/55">
              Ya tienes cuenta?
              <a href="/login" class="text-ink underline decoration-1 underline-offset-4 hover:text-moss">Iniciar sesion</a>
            </p>
          </div>
        </section>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import { supabase } from '../lib/supabase';

    const form = document.getElementById('register-form');
    const feedback = document.getElementById('register-feedback');
    const button = document.getElementById('btn-register');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const emailInput = document.getElementById('email');
      const passwordInput = document.getElementById('password');
      const nameInput = document.getElementById('name');

      const email = (emailInput instanceof HTMLInputElement ? emailInput.value : '').trim();
      const password = passwordInput instanceof HTMLInputElement ? passwordInput.value : '';
      const name = (nameInput instanceof HTMLInputElement ? nameInput.value : '').trim();

      if (!email || !password || !name) {
        if (feedback) {
          feedback.textContent = 'Completa nombre, email y contrasena.';
          feedback.className = 'text-sm text-red-700 min-h-6';
        }
        return;
      }

      if (password.length < 6) {
        if (feedback) {
          feedback.textContent = 'La contrasena debe tener al menos 6 caracteres.';
          feedback.className = 'text-sm text-red-700 min-h-6';
        }
        return;
      }

      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
        button.textContent = 'Creando cuenta...';
      }
      if (feedback) feedback.textContent = '';

      const { error } = await supabase.auth.signUp({
        email,
        password,
        options: { data: { full_name: name } },
      });

      if (error) {
        if (feedback) {
          feedback.textContent = error.message;
          feedback.className = 'text-sm text-red-700 min-h-6';
        }
        if (button instanceof HTMLButtonElement) {
          button.disabled = false;
          button.textContent = 'Crear cuenta y continuar al pago';
        }
        return;
      }

      window.location.href = '/pago?source=registro';
    });
  </script>
</Layout>
