---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/ui/Button.astro';
---

<Layout
  title="Reserva | El Arbol Que Suena"
  description="Resumen de compra del curso de neuroeducacion musical antes de pasar al pago seguro."
>
  <Header />

  <main class="bg-white pt-24 md:pt-28 pb-16 md:pb-20">
    <section class="section-shell pt-8 md:pt-10 pb-14 md:pb-16">
      <div class="content-shell max-w-3xl space-y-10 md:space-y-12">
        <header class="text-center max-w-2xl mx-auto space-y-5" data-reveal>
          <p class="editorial-kicker">Paso 1 de 2</p>
          <h1 class="headline-luxe section-title">
            Tu carrito de la formacion.
          </h1>
          <p class="lead-copy">
            Revisa todo lo que incluye esta edicion y pasa al pago seguro con Stripe para confirmar tu plaza.
          </p>
        </header>

        <section class="ui-panel p-7 md:p-10 max-w-2xl mx-auto space-y-7" data-reveal style="--reveal-delay:120ms">
          <div class="space-y-2">
            <p class="editorial-kicker">Curso seleccionado</p>
            <h2 class="font-display text-4xl md:text-5xl text-note leading-[1.02]">
              Neuroeducacion musical para docentes de 0 a 9 anos.
            </h2>
            <p class="text-sm text-ink/62">Foco principal: primera infancia (0 a 6 anos).</p>
          </div>

          <div class="space-y-3 text-sm text-ink/78">
            <p class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-ochre mt-2"></span>Primera edicion 2026 · formato online.</p>
            <p class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-ochre mt-2"></span>6 modulos de especializacion + certificacion de la escuela.</p>
            <p class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-ochre mt-2"></span>Plazas limitadas: maximo 20 docentes por convocatoria.</p>
            <p class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-ochre mt-2"></span>Acceso privado activado tras confirmacion de pago.</p>
          </div>

          <div class="border-t border-clay/60 pt-6 space-y-2">
            <div class="flex items-end justify-between gap-4">
              <p class="text-sm text-ink/72">Precio hoy</p>
              <p class="font-display text-5xl italic text-note">390 EUR</p>
            </div>
            <p class="text-xs uppercase tracking-[0.18em] text-ink/58">Oferta de lanzamiento · luego 490 EUR</p>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 sm:items-center pt-2">
            <Button href="/pago?source=carrito_registro" size="lg" variant="primary" class="cta-breathe">Ir al pago seguro</Button>
            <Button href="/#precio" size="lg" variant="secondary">Volver a la informacion</Button>
          </div>
        </section>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
