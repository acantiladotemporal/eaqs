---
import NewsletterCard from './NewsletterCard.astro';
import BrandLockup from './BrandLockup.astro';
interface Props { mode?: 'default' | 'learning' | 'focused'; preview?: boolean; newsletter?: boolean; }
const learning = Astro.props.mode === 'learning';
const focused = Astro.props.mode === 'focused';
const showNewsletter = !learning && !focused && Astro.props.newsletter !== false;
const preview = import.meta.env.DEV && Astro.props.preview;
const newsletterId = Astro.url.pathname === '/' ? 'newsletter-footer' : 'newsletter';
---
<footer class:list={['site-footer', { 'footer-learning': learning, 'footer-focused': focused, 'footer-compact': focused || (!learning && !showNewsletter) }]}>
  <div class="footer-shell">
    <div class="footer-brand">
      <BrandLockup variant="footer" />
    </div>
    {showNewsletter && <NewsletterCard id={newsletterId} />}
    <nav class="footer-links" aria-label="Pie de página">{learning ? <><a href={preview ? '/vista-previa/aula' : '/dashboard'}>Mi Itinerario</a><a href={preview ? '/vista-previa/comunidad' : '/foro'}>Comunidad</a></> : !focused && <><a href="/programa">La Formación</a><a href="/metodologia">La Mirada</a><a href="/registro">Solicitar Plaza</a>{showNewsletter && <a href={`#${newsletterId}`}>Newsletter</a>}</>}<a href="/contacto">Contacto</a><a href="/privacidad">Privacidad</a><a href="/cookies">Cookies</a><a href="/aviso-legal">Aviso Legal</a><a href="/terminos">Términos</a></nav>
    <div class="footer-bottom"><p>© {new Date().getFullYear()} El Árbol Que Suena · Escuela Internacional de Neuroeducación Musical</p></div>
  </div>
</footer>
