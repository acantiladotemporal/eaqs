---
import LearningShell from '../components/LearningShell.astro';
import { INITIAL_COHORT_ID, madridDate } from '../components/learning';
const { db, user, enrollment } = Astro.locals;
if (!db || !user) return Astro.redirect('/login');
const cohortId = enrollment?.cohort_id || INITIAL_COHORT_ID;
const [certificateResult, profileResult, cohortResult] = await Promise.all([
  db.from('certificates').select('id,certificate_number,issued_at').eq('cohort_id', cohortId).eq('user_id', user.id).maybeSingle(),
  db.from('profiles').select('full_name').eq('id', user.id).maybeSingle(),
  db.from('cohorts').select('title').eq('id', cohortId).maybeSingle(),
]);
const certificate = certificateResult.data;
const failed = certificateResult.error || profileResult.error || cohortResult.error;
---
<LearningShell title="Un recorrido que deja huella." eyebrow="Certificado propio de la escuela" description="La escuela emitirá tu certificado una vez completados los cuestionarios y aprobado el trabajo final.">
  {failed ? <p class="notice error">No hemos podido consultar tu certificado. Vuelve a intentarlo más tarde.</p> : certificate ? <>
    <article class="certificate" aria-label="Certificado de finalización">
      <img src="/images/brand-logo.png" width="230" height="230" alt="El Árbol Que Suena" />
      <p class="eyebrow">Escuela Internacional de Neuroeducación Musical</p>
      <h2>Certificado de finalización</h2>
      <p>El Árbol Que Suena hace constar que</p><p class="student-name">{profileResult.data?.full_name || user.user_metadata?.full_name || user.email}</p>
      <p>ha completado el itinerario de diez módulos y el trabajo final del</p><h3>Curso de Neuroeducación Musical para docentes de 0 a 6 años</h3>
      <p>{cohortResult.data?.title || 'Primera edición'}</p>
      <div class="certificate-meta"><p>Fecha de emisión<br /><strong>{madridDate(certificate.issued_at)}</strong></p><p>Referencia<br /><strong>{certificate.certificate_number}</strong></p></div>
      <p class="muted">Certificado propio emitido por El Árbol Que Suena.</p>
    </article>
    <div class="print-actions"><button type="button" class="button" id="print-certificate">Imprimir o guardar como PDF</button></div>
  </> : <section class="empty-state"><h2>Tu certificado todavía no está emitido.</h2><p>Continúa con el itinerario y entrega tu trabajo final. Cuando la docente confirme su aprobación y la finalización del curso, aparecerá aquí.</p><a href="/trabajo-final" class="button button-secondary">Consultar el trabajo final</a></section>}
</LearningShell>
<script>document.getElementById('print-certificate')?.addEventListener('click', () => window.print());</script>
<style>
.certificate{border:1px solid #b5aa91;outline:1px solid #e2d7c8;outline-offset:-.75rem;padding:3rem;text-align:center;background:#fffdf8;max-width:60rem;margin:0 auto}.certificate img{width:180px;height:140px;object-fit:contain;margin:0 auto 1rem}.certificate h2{font-size:2.6rem}.student-name{font-family:var(--serif);font-size:2.6rem;color:var(--ink)}.certificate h3{font-size:1.7rem;max-width:40rem;margin:1.5rem auto}.certificate-meta{display:flex;justify-content:space-around;gap:2rem;margin:3rem 0 2rem}.print-actions{margin:2rem auto;text-align:center}@media(max-width:600px){.certificate{padding:2rem 1.3rem}.certificate h2,.student-name{font-size:2rem}.certificate-meta{flex-direction:column;gap:.5rem}}@media print{:global(header),:global(footer),:global(.page-heading),.print-actions{display:none!important}.certificate{break-inside:avoid;max-width:none;margin:0;font-size:12pt;padding:2cm}.certificate h2{font-size:24pt}.student-name{font-size:26pt}}
</style>

